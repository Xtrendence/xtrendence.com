{
	"name": "clicker",
	"author": "xtrendence",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"dev:host": "vite --host",
		"api": "tsx watch api/server.ts",
		"build": "tsc -b && vite build",
		"build:prod": "tsc -b && vite build && pm2 restart lights",
		"format": "npx @biomejs/biome format --write ./",
		"lint": "npx @biomejs/biome lint --write ./",
		"preview": "vite preview"
	},
	"dependencies": {
		"@tanstack/react-query": "^5.104.5",
		"@types/cookie-parser": "^1.4.10",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"axios": "^1.20.0",
		"better-sqlite3": "^12.11.1",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.6",
		"dayjs": "^1.11.23",
		"dotenv": "^17.4.2",
		"express": "^5.3.0",
		"jotai": "^2.20.3",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"remeda": "^2.53.0",
		"tsx": "^4.23.15",
		"usehooks-ts": "^3.1.1",
		"vite-tsconfig-paths": "^5.1.4"
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"@types/node": "^24.19.2",
		"@types/react": "^18.3.31",
		"@types/react-dom": "^18.3.7",
		"@vitejs/plugin-react": "^4.7.0",
		"autoprefixer": "^10.6.1",
		"postcss": "^8.5.31",
		"tailwindcss": "^3.4.19",
		"typescript": "^5.9.3",
		"vite": "^5.4.21"
	}
