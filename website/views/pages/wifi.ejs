<!DOCTYPE html>
<html lang="en" class="dark">
    <head>
        <title>Xtrendence | WiFi</title>
        <%- include('../partials/core/head-app'); %>
    </head>
    <body class="page-wifi">
        <%- include('../partials/portfolio/chrome'); %> <%-
        include('../partials/portfolio/back'); %> <%-
        include('../partials/portfolio/dock'); %>

        <main class="app app--center">
            <div class="card glass glass--lit qr-card reveal">
                <div class="qr-head">
                    <span class="eyebrow">Network</span>
                    <h1>Scan to join.</h1>
                    <p>
                        Point a camera at the code and the device will connect
                        on its own.
                    </p>
                </div>

                <div class="qr-frame"><%- svg %></div>

                <div class="qr-meta">
                    <span class="mini-title">Raw payload</span>
                    <code class="readout"><%= qr %></code>
                    <button class="btn btn--ghost btn--sm" type="button" id="copy-wifi">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path
                                d="M9 2h9a2 2 0 0 1 2 2v11h-2V4H9V2ZM6 6h9a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2Zm0 2v12h9V8H6Z"
                            />
                        </svg>
                        <span>Copy</span>
                    </button>
                </div>
            </div>
        </main>

        <style>
            .qr-card {
                width: 100%;
                max-width: 400px;
                display: flex;
                flex-direction: column;
                gap: 20px;
            }

            .qr-head {
                display: flex;
                flex-direction: column;
                gap: 10px;
            }

            .qr-head h1 {
                font-size: 28px;
            }

            .qr-head p {
                font-size: 14.5px;
                color: var(--ink-2);
            }

            .qr-meta {
                display: flex;
                flex-direction: column;
                gap: 10px;
            }

            .qr-meta .btn {
                align-self: flex-start;
            }
        </style>

        <script src="/assets/js/device.js"></script>
        <script src="/assets/js/main.js"></script>
        <script src="/assets/js/storage.js"></script>
        <script src="/assets/js/app.js"></script>

        <script>
            (() => {
                const button = document.getElementById('copy-wifi');
                const label = button.querySelector('span');
                const payload = document.querySelector('.readout').textContent;

                button.addEventListener('click', async () => {
                    try {
                        await navigator.clipboard.writeText(payload);
                        label.textContent = 'Copied';
                        setTimeout(() => {
                            label.textContent = 'Copy';
                        }, 1600);
                    } catch {
                        Notify.error({
                            title: 'Copy Failed',
                            description:
                                'The clipboard is not available on this device.',
                            duration: 4000,
                        });
                    }
                });
            })();
        </script>
    </body>
</html>
