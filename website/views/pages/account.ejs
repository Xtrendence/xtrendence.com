<!DOCTYPE html>
<html lang="en" class="dark">
    <head>
        <title>Xtrendence | Account</title>
        <%- include('../partials/core/head-app'); %>
    </head>
    <body class="page-account">
        <%- include('../partials/portfolio/chrome'); %> <%-
        include('../partials/portfolio/back'); %> <%-
        include('../partials/portfolio/dock'); %>

        <main class="app app--center">
            <div class="card glass glass--lit account-card reveal">
                <div class="account-head">
                    <span class="eyebrow">Account</span>
                    <h1 id="account-name">Signed in.</h1>
                    <p>
                        Scan the code to carry this session to another device.
                        The token below is what grants access, so keep it to
                        yourself.
                    </p>
                </div>

                <div class="qr-frame">
                    <div class="image-container"><span class="qr-empty">No token stored.</span></div>
                </div>

                <div class="account-meta">
                    <span class="mini-title">Session token</span>
                    <code class="readout token"></code>
                    <div class="account-actions">
                        <button
                            class="btn btn--ghost btn--sm"
                            type="button"
                            id="copy-token"
                        >
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path
                                    d="M9 2h9a2 2 0 0 1 2 2v11h-2V4H9V2ZM6 6h9a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2Zm0 2v12h9V8H6Z"
                                />
                            </svg>
                            <span>Copy</span>
                        </button>
                        <button
                            class="btn btn--ghost btn--sm"
                            type="button"
                            id="restart-docker"
                        >
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path
                                    d="M12 4V1L8 5l4 4V6a6 6 0 1 1-6 6H4a8 8 0 1 0 8-8Z"
                                />
                            </svg>
                            <span>Restart Docker</span>
                        </button>
                        <a class="btn btn--ghost btn--sm" href="/logout">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path
                                    d="M11 2h2v10h-2V2Zm5.2 2.2A9 9 0 1 1 7.8 4.2l1 1.8a7 7 0 1 0 6.4 0l1-1.8Z"
                                />
                            </svg>
                            <span>Logout</span>
                        </a>
                    </div>
                </div>
            </div>
        </main>

        <style>
            .account-card {
                width: 100%;
                max-width: 400px;
                display: flex;
                flex-direction: column;
                gap: 20px;
            }

            .account-head {
                display: flex;
                flex-direction: column;
                gap: 10px;
            }

            .account-head h1 {
                font-size: 28px;
            }

            .account-head p {
                font-size: 14.5px;
                color: var(--ink-2);
            }

            .account-meta {
                display: flex;
                flex-direction: column;
                gap: 10px;
            }

            .account-actions {
                display: flex;
                flex-wrap: wrap;
                gap: 8px;
            }

            .qr-empty {
                font-family: var(--font-mono);
                font-size: 12px;
                color: var(--ink-3);
            }

            /* The generated QR is painted white for the dark surface. */
            .qr-frame svg {
                width: 232px;
                height: 232px;
            }
        </style>

        <script src="/assets/js/device.js"></script>
        <script src="/assets/js/main.js"></script>
        <script src="/assets/js/storage.js"></script>
        <script src="/assets/js/app.js"></script>

        <script>
            (async () => {
                const imageContainer =
                    document.getElementsByClassName('image-container')[0];
                const codeToken = document.getElementsByClassName('token')[0];
                const name = document.getElementById('account-name');
                const token = localStorage.getItem('token');

                codeToken.textContent = token || 'No token stored.';

                if (!token) return;

                try {
                    const data = await sendRequest(
                        `/auth/qr/${token}/svg`,
                        'GET'
                    );
                    imageContainer.innerHTML = data.replace(
                        /fill:#000/g,
                        'fill:#fff'
                    );
                } catch (error) {
                    console.log(error);
                }

                // auth.js resolves the username a moment after the page loads
                const poll = setInterval(() => {
                    if (typeof account === 'undefined' || !account?.username) {
                        return;
                    }

                    name.textContent = `Hey, ${account.username}.`;
                    clearInterval(poll);
                }, 300);

                setTimeout(() => clearInterval(poll), 5000);

                document
                    .getElementById('copy-token')
                    .addEventListener('click', async (event) => {
                        const label = event.currentTarget.querySelector('span');

                        try {
                            await navigator.clipboard.writeText(token);
                            label.textContent = 'Copied';
                            setTimeout(() => {
                                label.textContent = 'Copy';
                            }, 1600);
                        } catch {
                            Notify.error({
                                title: 'Copy Failed',
                                description:
                                    'The clipboard is not available on this device.',
                                duration: 4000,
                            });
                        }
                    });

                document
                    .getElementById('restart-docker')
                    .addEventListener('click', async () => {
                        try {
                            await sendRequest('/docker', 'GET');
                            Notify.success({
                                title: 'Docker Restarted',
                                description: 'The containers are coming back up.',
                                duration: 4000,
                            });
                        } catch (error) {
                            console.log(error);
                            Notify.error({
                                title: 'Restart Failed',
                                description:
                                    'Docker did not restart. Check the server logs.',
                                duration: 4000,
                            });
                        }
                    });
            })();
        </script>
    </body>
</html>
