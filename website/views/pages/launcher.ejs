<!DOCTYPE html>
<html lang="en" class="dark">
    <head>
        <title>Xtrendence | Launcher</title>
        <%- include('../partials/core/head-app'); %>
    </head>
    <body class="page-launcher">
        <%- include('../partials/portfolio/chrome'); %> <%-
        include('../partials/portfolio/back'); %> <%-
        include('../partials/portfolio/dock'); %>

        <%
            const groups = [
                {
                    title: 'Watch and request',
                    services: [
                        {
                            name: 'Jellyfin',
                            description: 'Stream the movie and TV library',
                            host: 'jellyfin.xtrendence.com',
                            icon: 'M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm-2 5.5 6.5 4.5-6.5 4.5v-9Z',
                        },
                        {
                            name: 'Seerr',
                            description: 'Find and request new titles',
                            host: 'seerr.xtrendence.com',
                            icon: 'M12 2l2.1 6.3L20.5 10l-6.4 1.7L12 18l-2.1-6.3L3.5 10l6.4-1.7L12 2Zm7 13 .9 2.1 2.1.9-2.1.9L19 21l-.9-2.1-2.1-.9 2.1-.9L19 15Z',
                        },
                    ],
                },
                {
                    title: 'Library automation',
                    services: [
                        {
                            name: 'Sonarr',
                            description: 'Track and fetch TV episodes',
                            host: 'sonarr.xtrendence.com',
                            icon: 'M4 4h16a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2h-7v2h4v2H7v-2h4v-2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Zm0 2v10h16V6H4Z',
                        },
                        {
                            name: 'Radarr',
                            description: 'Track and fetch movies',
                            host: 'radarr.xtrendence.com',
                            icon: 'M4 3h16a1 1 0 0 1 1 1v16a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1Zm1 2v2h2V5H5Zm12 0v2h2V5h-2ZM5 9v2h2V9H5Zm12 0v2h2V9h-2ZM5 13v2h2v-2H5Zm12 0v2h2v-2h-2ZM5 17v2h2v-2H5Zm12 0v2h2v-2h-2ZM9 5v14h6V5H9Z',
                        },
                        {
                            name: 'Bazarr',
                            description: 'Subtitles for everything',
                            host: 'bazarr.xtrendence.com',
                            icon: 'M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Zm0 2v12h16V6H4Zm2 7h5v2H6v-2Zm7 0h5v2h-5v-2Zm-7-3h12v2H6v-2Z',
                        },
                        {
                            name: 'Prowlarr',
                            description: 'Indexers for Sonarr and Radarr',
                            host: 'prowlarr.xtrendence.com',
                            icon: 'M10 2a8 8 0 0 1 6.3 12.9l5.4 5.4-1.4 1.4-5.4-5.4A8 8 0 1 1 10 2Zm0 2a6 6 0 1 0 0 12 6 6 0 0 0 0-12Z',
                        },
                    ],
                },
                {
                    title: 'Downloads',
                    services: [
                        {
                            name: 'qBittorrent',
                            description: 'Torrent client, behind the VPN',
                            host: 'qbittorrent.xtrendence.com',
                            icon: 'M11 3h2v9.6l3.3-3.3 1.4 1.4L12 16.4l-5.7-5.7 1.4-1.4 3.3 3.3V3ZM4 18h16v2H4v-2Z',
                        },
                        {
                            name: 'Qui',
                            description: 'Modern interface for qBittorrent',
                            host: 'qui.xtrendence.com',
                            icon: 'M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Zm0 2v3h16V6H4Zm0 5v7h16v-7H4Zm2 2h8v2H6v-2Z',
                        },
                    ],
                },
            ];
            let index = 0;
        %>

        <main class="app">
            <div class="app-head reveal">
                <span class="eyebrow">Launcher</span>
                <h1>Media, one tap away.</h1>
                <p>
                    Every app in the media stack, opened on its public address.
                    Each one still asks for its own login.
                </p>
            </div>

            <% for (const group of groups) { %>
                <section class="launcher-group">
                    <span class="eyebrow reveal"><%= group.title %></span>

                    <div class="tile-grid">
                        <% for (const service of group.services) { %>
                            <a
                                class="tile glass glass--lit reveal"
                                href="https://<%= service.host %>"
                                target="_blank"
                                rel="noopener noreferrer"
                                style="--delay: <%= (index++) * 60 %>ms"
                            >
                                <span class="tile-icon glass" aria-hidden="true">
                                    <svg viewBox="0 0 24 24">
                                        <path d="<%= service.icon %>" />
                                    </svg>
                                </span>
                                <b><%= service.name %></b>
                                <span><%= service.description %></span>
                                <small class="tile-host"><%= service.host %></small>
                                <svg class="tile-go" viewBox="0 0 24 24" aria-hidden="true">
                                    <path
                                        d="M14 3h7v7h-2V6.4l-8.3 8.3-1.4-1.4L17.6 5H14V3ZM5 5h5v2H6v11h11v-4h2v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Z"
                                    />
                                </svg>
                            </a>
                        <% } %>
                    </div>
                </section>
            <% } %>

            <% if (locals.theme) { %>
                <div class="card glass theme-card reveal">
                    <div class="theme-text">
                        <b>Liquid Glass theme</b>
                        <span id="theme-detail"><%= new Intl.ListFormat('en-GB', { type: 'conjunction' }).format(theme.apps.map((app) => app.name)) %>, in the style of this site</span>
                    </div>
                    <label class="toggle" title="Liquid Glass theme">
                        <input type="checkbox" id="theme-toggle" <%= theme.on ? 'checked' : '' %> />
                        <span class="toggle-track"><span class="toggle-thumb"></span></span>
                        <span class="toggle-label">Liquid Glass theme</span>
                    </label>
                </div>
            <% } %>
        </main>

        <style>
            .launcher-group {
                display: flex;
                flex-direction: column;
                gap: 16px;
                margin-top: 38px;
            }

            .theme-card {
                display: flex;
                align-items: center;
                gap: 18px;
                margin-top: 46px;
                padding: 18px 22px;
                max-width: 560px;
            }

            .theme-text {
                display: flex;
                flex-direction: column;
                gap: 2px;
            }

            .theme-text b {
                font-size: 15px;
                font-weight: 600;
                letter-spacing: -0.02em;
            }

            .theme-text span {
                font-size: 13px;
                color: var(--ink-3);
            }

            /* Same switch as the server dashboard */
            .page-launcher .toggle {
                position: relative;
                display: inline-flex;
                align-items: center;
                margin-left: auto;
                cursor: pointer;
            }

            .page-launcher .toggle input {
                position: absolute;
                opacity: 0;
                pointer-events: none;
            }

            .page-launcher .toggle-label {
                position: absolute;
                width: 1px;
                height: 1px;
                overflow: hidden;
                clip: rect(0 0 0 0);
                white-space: nowrap;
            }

            .page-launcher .toggle-track {
                position: relative;
                width: 36px;
                height: 20px;
                border-radius: var(--r-pill);
                background: var(--hairline);
                border: 1px solid var(--hairline);
                transition: background 0.25s var(--ease), border-color 0.25s var(--ease);
            }

            .page-launcher .toggle-thumb {
                position: absolute;
                top: 2px;
                left: 2px;
                width: 14px;
                height: 14px;
                border-radius: 50%;
                background: var(--ink-3);
                transition: transform 0.3s var(--ease-spring, var(--ease)), background 0.25s var(--ease);
            }

            .page-launcher .toggle input:checked + .toggle-track {
                background: var(--accent-bg);
                border-color: var(--accent-line);
            }

            .page-launcher .toggle input:checked + .toggle-track .toggle-thumb {
                transform: translateX(16px);
                background: var(--accent-fill);
                box-shadow: 0 0 8px var(--accent-glow);
            }

            .page-launcher .toggle input:focus-visible + .toggle-track {
                outline: 2px solid var(--accent-fill);
                outline-offset: 2px;
            }

            .page-launcher .toggle input:disabled + .toggle-track {
                opacity: 0.5;
            }

            .tile-host {
                margin-top: auto;
                font-family: var(--font-mono);
                font-size: 11px;
                letter-spacing: 0.02em;
                color: var(--ink-3);
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
            }
        </style>

        <script src="/assets/js/device.js"></script>
        <script src="/assets/js/main.js"></script>
        <script src="/assets/js/storage.js"></script>
        <script src="/assets/js/app.js"></script>

        <script>
            (() => {
                const toggle = document.getElementById('theme-toggle');
                if (!toggle) return;

                toggle.addEventListener('change', async () => {
                    const wanted = toggle.checked;
                    toggle.disabled = true;

                    try {
                        const response = await fetch('/launcher/theme', {
                            method: 'POST',
                            credentials: 'same-origin',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ on: wanted }),
                        });
                        const data = await response.json();
                        if (!response.ok) throw new Error(data?.error ?? `HTTP ${response.status}`);

                        toggle.checked = data.on;
                        Notify.success({
                            title: data.on ? 'Liquid Glass On' : 'Stock Theme',
                            description: 'Refresh Seerr and qBittorrent to see the change.',
                            duration: 4000,
                        });
                    } catch (error) {
                        toggle.checked = !wanted;
                        Notify.error({
                            title: 'Theme Not Switched',
                            description: error.message,
                            duration: 4000,
                        });
                    } finally {
                        toggle.disabled = false;
                    }
                });
            })();
        </script>
    </body>
</html>
