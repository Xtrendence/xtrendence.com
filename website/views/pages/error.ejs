<!DOCTYPE html>
<html lang="en" class="dark">
    <head>
        <title>Xtrendence | Error</title>
        <%- include('../partials/core/head-app'); %>
    </head>
    <body class="page-error">
        <%- include('../partials/portfolio/chrome'); %> <%-
        include('../partials/portfolio/back'); %> <%-
        include('../partials/portfolio/dock'); %>

        <main class="app app--center">
            <div class="error-card glass glass--lit reveal">
                <span class="error-code gradient-text"><%= code %></span>
                <h1><%= status %></h1>
                <p><%= message %></p>
                <div class="error-actions">
                    <a class="btn btn--accent" href="/">
                        Back home
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path
                                d="M13.6 4.4 12.2 5.8l5.2 5.2H3v2h14.4l-5.2 5.2 1.4 1.4L21.2 12z"
                            />
                        </svg>
                    </a>
                    <button class="btn btn--ghost" type="button" id="error-back">
                        Go back
                    </button>
                </div>
            </div>
        </main>

        <script src="/assets/js/device.js"></script>
        <script src="/assets/js/main.js"></script>
        <script src="/assets/js/storage.js"></script>
        <script src="/assets/js/app.js"></script>

        <script>
            document
                .getElementById('error-back')
                .addEventListener('click', () => {
                    if (window.history.length > 1) {
                        window.history.back();
                        return;
                    }

                    window.location.href = '/';
                });
        </script>
    </body>
</html>
