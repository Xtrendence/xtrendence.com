<!DOCTYPE html>
<html lang="en" class="dark">

<head>
	<title>Xtrendence | Server</title>
	<%- include('../partials/core/head-app'); %>
		<link rel="stylesheet" href="/assets/css/server.css" />
</head>

<body class="page-server<%= viewOnly ? ' view-only' : '' %>">
	<%- include('../partials/portfolio/chrome'); %> <%- include('../partials/portfolio/back'); %> <%-
				include('../partials/portfolio/dock'); %>

				<main class="app server-inner">
					<div class="card glass glass--lit server-header reveal">
						<div>
							<div class="title">
								<span class="health" id="health" role="img" aria-label="Health: all clear"></span>
								<span id="hostname">Server</span>
							</div>
							<div class="subtitle" id="host-detail">Loading metrics...</div>
						</div>
						<div class="header-side">
							<% if (viewOnly) { %>
								<span class="view-banner" id="view-banner">View only</span>
								<% } else { %>
									<button class="btn btn--sm btn--ghost reboot-button" type="button" id="reboot-button">
										<svg viewBox="0 0 24 24" aria-hidden="true">
											<path
												d="M11 2h2v10h-2V2Zm-4.2 3.3 1.4 1.4A6.5 6.5 0 1 0 15.8 6.7l1.4-1.4A8.5 8.5 0 1 1 6.8 5.3Z" />
										</svg>
										<span>Reboot</span>
									</button>
									<button class="btn btn--sm btn--ghost share-button" type="button" id="share-button">
										<svg viewBox="0 0 24 24" aria-hidden="true">
											<path
												d="M18 16a3 3 0 0 0-2.4 1.2l-6.7-3.4a3 3 0 0 0 0-1.6l6.7-3.4A3 3 0 1 0 15 7l-6.7 3.4a3 3 0 1 0 0 3.2L15 17a3 3 0 1 0 3-1Z" />
										</svg>
										<span>Share</span>
									</button>
									<button class="btn btn--sm btn--ghost password-button" type="button" id="password-button"
										aria-label="Change the server password" title="Change the server password">
										<svg viewBox="0 0 24 24" aria-hidden="true">
											<path class="lock-shackle" d="M8 10V7.5a4 4 0 0 1 8 0V10h-2V7.5a2 2 0 0 0-4 0V10H8Z" />
											<path d="M6 10h12a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1v-9a1 1 0 0 1 1-1Zm6 3.5a1.5 1.5 0 0 0-1 2.6V18h2v-1.9a1.5 1.5 0 0 0-1-2.6Z" />
										</svg>
									</button>
									<% } %>
										<div class="live" id="live">
											<div class="dot"></div>
											<span id="live-text">Live</span>
										</div>
						</div>
					</div>

					<div class="card glass glass--lit panel time-machine reveal" id="time-machine">
						<div class="tm-head">
							<h2>Time machine <span class="count" id="tm-meta">Loading</span></h2>
							<div class="range-tabs" role="tablist" aria-label="Time machine range" id="tm-ranges">
								<button type="button" role="tab" data-range="6h">6h</button>
								<button type="button" role="tab" data-range="24h">24h</button>
								<button type="button" role="tab" data-range="7d">7d</button>
								<button type="button" role="tab" data-range="90d">90d</button>
							</div>
						</div>
						<div class="tm-deck">
							<div class="tm-controls">
								<button class="tm-btn" type="button" id="tm-prev" aria-label="Previous snapshot"
									title="Previous snapshot">
									<svg viewBox="0 0 24 24" aria-hidden="true">
										<path d="M15.4 7.4 14 6l-6 6 6 6 1.4-1.4-4.6-4.6Z" />
									</svg>
								</button>
								<button class="tm-btn tm-play" type="button" id="tm-play" aria-label="Play" title="Play forward">
									<svg class="play" viewBox="0 0 24 24" aria-hidden="true">
										<path d="M8 5v14l11-7Z" />
									</svg>
									<svg class="pause" viewBox="0 0 24 24" aria-hidden="true">
										<path d="M7 5h4v14H7Zm6 0h4v14h-4Z" />
									</svg>
								</button>
								<button class="tm-btn" type="button" id="tm-next" aria-label="Next snapshot" title="Next snapshot">
									<svg viewBox="0 0 24 24" aria-hidden="true">
										<path d="M8.6 16.6 10 18l6-6-6-6-1.4 1.4 4.6 4.6Z" />
									</svg>
								</button>
							</div>
							<div class="tm-track" id="tm-track">
								<canvas class="tm-canvas" id="tm-canvas" aria-hidden="true"></canvas>
								<div class="tm-playhead" id="tm-playhead" aria-hidden="true"><span class="tm-stamp"
										id="tm-stamp">Now</span></div>
								<input class="tm-slider" type="range" id="tm-slider" min="0" max="1" step="60000" value="1"
									aria-label="Point in time" />
							</div>
							<button class="btn btn--sm btn--accent tm-live" type="button" id="tm-live">Back to live</button>
						</div>
						<div class="tm-axis" id="tm-axis" aria-hidden="true"></div>
					</div>

					<div class="card glass glass--lit panel alerts reveal">
						<h2>Alerts <span class="count" id="alert-meta">Waiting for first check</span></h2>
						<div class="issues" id="issues">
							<div class="empty">No check has run yet.</div>
						</div>

						<div class="rules-head">
							<div>
								<h3>Rules</h3>
								<div class="rules-summary" id="rules-summary">Loading rules...</div>
							</div>
							<div class="rules-actions">
								<button class="btn btn--sm btn--ghost action" type="button" id="run-check">
									<span class="spinner"></span>
									<svg viewBox="0 0 24 24" aria-hidden="true">
										<path d="M12 4V1L8 5l4 4V6a6 6 0 1 1-6 6H4a8 8 0 1 0 8-8Z" />
									</svg>
									<span class="action-label">Run check</span>
								</button>
								<button class="btn btn--sm btn--ghost action" type="button" id="send-notification">
									<span class="spinner"></span>
									<svg viewBox="0 0 24 24" aria-hidden="true">
										<path
											d="M12 22a2.5 2.5 0 0 0 2.45-2h-4.9A2.5 2.5 0 0 0 12 22Zm7-6V11a7 7 0 0 0-5.5-6.84V3.5a1.5 1.5 0 0 0-3 0v.66A7 7 0 0 0 5 11v5l-2 2v1h18v-1l-2-2Z" />
									</svg>
									<span class="action-label">Send notification</span>
								</button>
								<button class="btn btn--sm btn--ghost rules-toggle" type="button" id="rules-toggle"
									aria-expanded="false" aria-controls="rules-body">
									<span class="edit">Edit rules</span>
									<span class="done">Done</span>
								</button>
							</div>
						</div>
						<div class="rules-body" id="rules-body" inert>
							<div class="rules-inner">
								<p class="rules-hint">Each indicator can stay quiet, raise a warning that turns the light purple, or
									raise a critical alert that turns it red. Checked every 5 minutes.</p>
								<div class="rules" id="rules">
									<div class="empty">Loading rules...</div>
								</div>
								<div class="rules-foot">
									<span class="rules-status" id="rules-status"></span>
									<button class="btn btn--sm btn--ghost" type="button" id="rules-reset" disabled>Discard</button>
									<button class="btn btn--sm btn--accent" type="button" id="rules-save" disabled>Save rules</button>
								</div>
							</div>
						</div>
					</div>

					<div class="stat-grid" id="stats"></div>

					<div class="card glass glass--lit panel trends live-only reveal">
						<div class="trends-head">
							<h2>Trends <span class="count" id="trends-meta">Loading</span></h2>
							<div class="range-tabs" role="tablist" aria-label="Time range" id="range-tabs">
								<button type="button" role="tab" data-range="24h">24h</button>
								<button type="button" role="tab" data-range="7d">7d</button>
								<button type="button" role="tab" data-range="30d">30d</button>
								<button type="button" role="tab" data-range="1y">1y</button>
							</div>
						</div>
						<div class="chart-grid" id="chart-grid"></div>

						<h3 class="trends-sub">Drives <span class="count">usage and forecast</span></h3>
						<div class="drive-trends" id="drive-trends">
							<div class="empty">Collecting data...</div>
						</div>

						<h3 class="trends-sub">Alert history <span class="count" id="timeline-count"></span></h3>
						<div class="alert-timeline" id="alert-timeline">
							<div class="empty">No alerts in this range.</div>
						</div>
					</div>

					<div class="card glass glass--lit panel energy live-only reveal" id="energy">
						<div class="trends-head">
							<h2>Energy <span class="count" id="energy-meta">Loading</span></h2>
							<div class="energy-actions">
								<% if (!viewOnly) { %>
									<button class="btn btn--sm btn--ghost action" type="button" id="energy-sync"
										title="Reads every plug's meter now instead of waiting for the next 15 minute sync">
										<span class="spinner"></span>
										<svg viewBox="0 0 24 24" aria-hidden="true">
											<path d="M12 4V1L8 5l4 4V6a6 6 0 1 1-6 6H4a8 8 0 1 0 8-8Z" />
										</svg>
										<span class="action-label">Sync now</span>
									</button>
									<% } %>
										<div class="range-tabs" role="tablist" aria-label="Energy range" id="energy-ranges">
											<button type="button" role="tab" data-range="1d">1D</button>
											<button type="button" role="tab" data-range="7d">7D</button>
											<button type="button" role="tab" data-range="30d">30D</button>
											<button type="button" role="tab" data-range="1y">1Y</button>
										</div>
							</div>
						</div>
						<div class="uptime-tiles energy-tiles" id="energy-tiles"></div>
						<div class="energy-charts">
							<div class="chart-card">
								<div class="chart-head">
									<span class="chart-label">Per plug</span>
									<span class="energy-unit" id="energy-unit"></span>
								</div>
								<div class="energy-legend" id="energy-legend"></div>
								<div class="chart-body" id="energy-plugs-chart"></div>
							</div>
							<div class="chart-card">
								<div class="chart-head">
									<span class="chart-label">Combined</span>
									<span class="chart-now" id="energy-total"></span>
								</div>
								<div class="chart-sub" id="energy-total-sub"></div>
								<div class="chart-body" id="energy-total-chart"></div>
							</div>
						</div>
					</div>

					<div class="card glass glass--lit panel internet live-only reveal">
						<div class="vpn-head">
							<h2>Internet <span class="count" id="internet-meta"></span></h2>
							<div class="internet-side">
								<span class="uplink-chip" id="internet-uplink" hidden></span>
								<% if (!viewOnly) { %>
									<button class="btn btn--sm btn--ghost tunnel-restart" type="button" id="tunnel-restart"
										title="Restarts cloudflared, the public site drops for a few seconds">
										<svg viewBox="0 0 24 24" aria-hidden="true">
											<path d="M12 4V1L8 5l4 4V6a6 6 0 1 1-6 6H4a8 8 0 1 0 8-8Z" />
										</svg>
										<span class="action-label">Restart tunnel</span>
									</button>
									<% } %>
										<span class="badge unknown" id="internet-state">Loading</span>
							</div>
						</div>
						<div class="uptime-tiles" id="uptime-tiles"></div>
						<div class="outage-strip" id="outage-strip"></div>
						<div class="outages" id="outage-list"></div>
						<div class="healing" id="healing" hidden>
							<h3>Self healing</h3>
							<div class="healing-list" id="healing-list"></div>
						</div>

						<div class="recovery" id="recovery">
							<div class="rules-head">
								<div>
									<h3>Recovery</h3>
									<div class="rules-summary" id="recovery-meta">Loading plugs from the lights tool...</div>
								</div>
								<div class="rules-actions">
									<button class="btn btn--sm btn--ghost" type="button" id="recovery-reset" disabled>Discard</button>
									<button class="btn btn--sm btn--accent" type="button" id="recovery-save" disabled>Save</button>
								</div>
							</div>
							<div class="flow" id="recovery-flow">
								<div class="flow-start">
									<span class="flow-dot"></span>
									<span>Router</span>
									<input type="text" id="recovery-gateway" maxlength="253" spellcheck="false" autocomplete="off"
										aria-label="Router address" />
									<span>up, internet down</span>
								</div>
								<label class="flow-wait">
									<span>for</span>
									<input type="number" id="recovery-down" min="1" max="120" step="1" inputmode="numeric"
										aria-label="Minutes down before restarting" />
									<span>min</span>
								</label>
								<div class="flow-device" id="recovery-modem" data-device="modem">
									<div class="flow-device-head">
										<span class="flow-step">1</span>
										<b>Modem</b>
										<label class="toggle" title="Enable Modem Reboot">
											<input type="checkbox" id="recovery-modem-on" />
											<span class="toggle-track"><span class="toggle-thumb"></span></span>
											<span class="toggle-label">Enable Modem Reboot</span>
										</label>
									</div>
									<select id="recovery-modem-plug" aria-label="Modem plug"></select>
									<span class="flow-status" id="recovery-modem-status"></span>
								</div>
								<label class="flow-wait" id="recovery-gap-wait">
									<span>then</span>
									<input type="number" id="recovery-gap" min="0" max="60" step="1" inputmode="numeric"
										aria-label="Minutes between the modem and router" />
									<span>min</span>
								</label>
								<div class="flow-device" id="recovery-router" data-device="router">
									<div class="flow-device-head">
										<span class="flow-step">2</span>
										<b>Router</b>
										<label class="toggle" title="Enable Router Reboot">
											<input type="checkbox" id="recovery-router-on" />
											<span class="toggle-track"><span class="toggle-thumb"></span></span>
											<span class="toggle-label">Enable Router Reboot</span>
										</label>
									</div>
									<select id="recovery-router-plug" aria-label="Router plug"></select>
									<span class="flow-status" id="recovery-router-status"></span>
								</div>
							</div>
							<p class="recovery-note" id="recovery-note"></p>
						</div>
					</div>

					<div class="card glass glass--lit panel reveal">
						<h2>Drives <span class="count" id="drive-count"></span></h2>
						<div id="drives">
							<div class="empty">Loading...</div>
						</div>
					</div>

					<div class="two-column">
						<div class="card glass glass--lit panel reveal">
							<h2>Power &amp; Uptime</h2>
							<div class="rows" id="power"></div>
						</div>
						<div class="card glass glass--lit panel reveal">
							<h2>Kernel Events <span class="count">this boot</span></h2>
							<div class="rows" id="events"></div>
						</div>
					</div>

					<div class="two-column">
						<div class="card glass glass--lit panel reveal">
							<h2>Services <span class="count" id="service-count"></span></h2>
							<div class="pill-list" id="services"></div>
						</div>
						<div class="card glass glass--lit panel reveal">
							<h2>Containers <span class="count" id="container-count"></span></h2>
							<div class="pill-list" id="containers"></div>
						</div>
					</div>
					<div class="card glass glass--lit panel vpn reveal">
						<div class="vpn-head">
							<h2>VPN <span class="count" id="vpn-count"></span></h2>
							<div class="vpn-actions">
								<span class="badge unknown" id="vpn-state">Loading</span>
								<button class="btn btn--sm btn--ghost vpn-restart" type="button" id="vpn-restart">
									<span class="spinner"></span>
									<svg viewBox="0 0 24 24" aria-hidden="true">
										<path d="M12 4V1L8 5l4 4V6a6 6 0 1 1-6 6H4a8 8 0 1 0 8-8Z" />
									</svg>
									<span class="action-label">Restart</span>
								</button>
							</div>
						</div>
						<div class="peers" id="vpn-peers">
							<div class="empty">Loading...</div>
						</div>
						<% if (!viewOnly) { %>
							<div class="vpn-exit" id="vpn-exit">
								<div class="vpn-exit-info">
									<span class="vpn-exit-kicker">Container VPN</span>
									<span class="vpn-exit-status" id="vpn-exit-status" role="status">Routed through gluetun</span>
								</div>
								<div class="vpn-exit-picker">
									<button class="vpn-exit-toggle" type="button" id="vpn-exit-toggle" aria-haspopup="listbox"
										aria-expanded="false">
										<span class="vpn-exit-dot" aria-hidden="true"></span>
										<span class="vpn-exit-current" id="vpn-exit-current">Loading</span>
										<svg viewBox="0 0 24 24" aria-hidden="true">
											<path d="m7 10 5 5 5-5H7Z" />
										</svg>
									</button>
									<div class="vpn-exit-menu glass" id="vpn-exit-menu" role="listbox" aria-label="VPN configs" hidden>
									</div>
								</div>
							</div>
							<% } %>
								<form class="vpn-new" id="vpn-new" autocomplete="off">
									<input type="text" id="vpn-new-name" placeholder="New profile name" maxlength="27"
										aria-label="New profile name" />
									<div class="levels tunnel-choice" role="radiogroup"
										aria-label="What the profile sends through the VPN">
										<label class="level" title="Only home network traffic goes through the VPN">
											<input type="radio" name="vpn-tunnel" value="lan" checked />
											<span>LAN only</span>
										</label>
										<label class="level"
											title="Everything goes through home, so sites see the home IP. The LAN still works">
											<input type="radio" name="vpn-tunnel" value="full" />
											<span>All traffic</span>
										</label>
									</div>
									<span class="vpn-new-status" id="vpn-new-status" role="status">Saved to Downloads/VPN Profiles</span>
									<button class="btn btn--sm btn--accent" type="submit" id="vpn-new-submit">Add profile</button>
								</form>
					</div>
					<div class="card glass glass--lit panel backups live-only reveal">
						<div class="backup-head">
							<div class="backup-title">
								<h2>Backups <span class="badge unknown" id="backup-state">Loading</span></h2>
								<div class="backup-meta" id="backup-meta"></div>
							</div>
							<div class="backup-actions">
								<button class="btn btn--sm btn--ghost action" type="button" id="backup-run">
									<span class="spinner"></span>
									<svg viewBox="0 0 24 24" aria-hidden="true">
										<path d="M5 20h14v-2H5v2Zm7-2 5-5h-3V4h-4v9H7l5 5Z" />
									</svg>
									<span class="action-label">Back up now</span>
								</button>
								<button class="btn btn--sm btn--ghost rules-toggle" type="button" id="backup-toggle"
									aria-expanded="false" aria-controls="backup-body">
									<span class="edit">Details</span>
									<span class="done">Hide</span>
								</button>
							</div>
						</div>
						<div class="backup-note" id="backup-note" hidden></div>
						<div class="drill" id="drill" data-state="unknown">
							<div class="drill-main">
								<svg class="drill-seal" viewBox="0 0 44 44" aria-hidden="true">
									<circle class="drill-ring-track" cx="22" cy="22" r="19" />
									<title id="drill-ring-title"></title>
									<circle class="drill-ring" id="drill-ring" cx="22" cy="22" r="19" pathLength="100" />
									<path class="drill-mark drill-mark--ok" d="m15 22.5 4.6 4.6L29.5 17" />
									<path class="drill-mark drill-mark--bad" d="m16.5 16.5 11 11m0-11-11 11" />
									<circle class="drill-mark drill-mark--idle" cx="22" cy="22" r="2.5" />
								</svg>
								<div class="drill-text">
									<div class="drill-title">Restore drill <button class="drill-verdict" type="button" id="drill-verdict"
											title="Show progress and details">Loading</button></div>
									<div class="drill-meta" id="drill-meta"></div>
								</div>
								<button class="btn btn--sm btn--ghost action" type="button" id="drill-run"
									title="Restores the newest backup into a throwaway container and checks every file">
									<span class="spinner"></span>
									<svg viewBox="0 0 24 24" aria-hidden="true">
										<path
											d="M12 2 4 5v6c0 5 3.4 9.7 8 11 4.6-1.3 8-6 8-11V5l-8-3Zm-1.2 14.6-3.5-3.5 1.4-1.4 2.1 2.1 4.6-4.6 1.4 1.4-6 6Z" />
									</svg>
									<span class="action-label">Run drill</span>
								</button>
							</div>
							<ol class="drill-checks" id="drill-checks" hidden></ol>
						</div>
						<div class="drill mirror" id="mirror" data-state="unknown">
							<div class="drill-main">
								<svg class="drill-seal" viewBox="0 0 44 44" aria-hidden="true">
									<circle class="drill-ring-track" cx="22" cy="22" r="19" />
									<title id="mirror-ring-title"></title>
									<circle class="drill-ring" id="mirror-ring" cx="22" cy="22" r="19" pathLength="100" />
									<path class="drill-mark drill-mark--ok" d="M15 19h11.5l-3-3M29 25H17.5l3 3" />
									<path class="drill-mark drill-mark--bad" d="m16.5 16.5 11 11m0-11-11 11" />
									<path class="drill-mark drill-mark--held" d="M19 16v12m6-12v12" />
									<circle class="drill-mark drill-mark--idle" cx="22" cy="22" r="2.5" />
								</svg>
								<div class="drill-text">
									<div class="drill-title">Vault mirror <span class="drill-verdict" id="mirror-verdict">Loading</span></div>
									<div class="drill-meta" id="mirror-meta"></div>
								</div>
								<% if (!viewOnly) { %>
									<button class="btn btn--sm btn--ghost drill-cancel" type="button" id="mirror-cancel" hidden>Stop</button>
								<% } %>
								<button class="btn btn--sm btn--ghost action" type="button" id="mirror-run"
