										? 'A backup or restore drill is running. The drive can be changed once it finishes.'
										: changing
											? `New backups go to ${picked.dir}.${picked.backups ? ` The ${picked.backups} already there are picked up.` : ''} The ${current.backups} on ${current.name} stay where they are and show again if you switch back.`
											: '';
