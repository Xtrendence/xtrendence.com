									document.getElementById('qr-title').innerText = download ? `${name}.conf` : name;
									document.getElementById('qr-eyebrow').innerText = download ? 'Download VPN profile' : 'VPN profile';
									document.getElementById('qr-intro').innerText = download
										? 'The file holds this profile\'s private key. Enter the server password to download it.'
										: 'The QR code holds this profile\'s private key. Enter the server password to show it.';
									document.getElementById('qr-submit').innerText = download ? 'Download' : 'Show QR';
