								// Owner only. Changes login, sudo, SSH, Samba and the VPN QR password together
								const passwordDialog = document.getElementById('password-dialog');
								if (passwordDialog) {
									const form = document.getElementById('password-form');
									const status = document.getElementById('password-status');
									const submit = document.getElementById('password-submit');
									const current = document.getElementById('password-current');
									const next = document.getElementById('password-new');
									const confirm = document.getElementById('password-confirm');
									const meter = document.getElementById('password-meter');
									const targets = [...document.querySelectorAll('#password-targets li')];

									const setStatus = (text, error = false) => {
										status.innerText = text;
										status.classList.toggle('is-error', error);
									};

									// Fills towards the 10 character minimum, then keeps going for length and variety
									const updateMeter = () => {
										const value = next.value;
										const variety = [/[a-z]/, /[A-Z]/, /\d/, /[^\w]/].filter((pattern) => pattern.test(value)).length;
										const score = value.length < 10 ? value.length / 10 * 0.5 : Math.min(1, 0.5 + (value.length - 10) / 20 + variety * 0.08);
										meter.style.width = `${Math.round(score * 100)}%`;
										meter.dataset.level = value.length < 10 ? 'short' : score < 0.8 ? 'fair' : 'strong';
									};

									const reset = () => {
										form.reset();
										form.hidden = false;
										document.getElementById('password-note').hidden = true;
										targets.forEach((item) => item.removeAttribute('data-state'));
										document.getElementById('password-title').innerText = 'Change password';
										submit.disabled = false;
										setStatus('');
										updateMeter();
									};

									document.getElementById('password-button').addEventListener('click', () => {
										reset();
										passwordDialog.showModal();
										current.focus();
									});
									next.addEventListener('input', updateMeter);

									form.addEventListener('submit', async (event) => {
										event.preventDefault();
