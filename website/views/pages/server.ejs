<!DOCTYPE html>
<html lang="en">

<head>
	<title>Xtrendence | Server</title>
	<%- include('../partials/core/head'); %>
		<style>
			.server-wrapper {
				width: 100%;
				height: 100%;
				overflow-y: auto;
				overflow-x: hidden;
				box-sizing: border-box;
				padding: 80px 20px 40px;
			}

			.server-inner {
				display: flex;
				flex-direction: column;
				row-gap: 20px;
				max-width: 1180px;
				margin: 0 auto;
			}

			.panel {
				padding: 20px;
				box-sizing: border-box;
			}

			.panel h2 {
				margin: 0 0 16px;
				font-size: 18px;
				font-weight: bold;
				color: rgb(255, 255, 255);
				letter-spacing: 0.4px;
			}

			.panel h2 .count {
				color: rgba(255, 255, 255, 0.45);
				font-weight: normal;
				margin-left: 8px;
			}

			.server-header {
				display: flex;
				align-items: center;
				justify-content: space-between;
				column-gap: 20px;
				row-gap: 12px;
				flex-wrap: wrap;
			}

			.server-header .title {
				font-size: 24px;
				font-weight: bold;
				color: rgb(255, 255, 255);
			}

			.server-header .subtitle {
				font-size: 14px;
				color: rgba(255, 255, 255, 0.55);
				margin-top: 4px;
			}

			.live {
				display: flex;
				align-items: center;
				column-gap: 8px;
				font-size: 13px;
				color: rgba(255, 255, 255, 0.55);
			}

			.live .dot {
				width: 9px;
				height: 9px;
				border-radius: 50%;
				background: rgb(80, 200, 130);
				animation: pulse 2s ease-in-out infinite;
			}

			.live.stale .dot {
				background: rgb(250, 90, 90);
				animation: none;
			}

			@keyframes pulse {
				0%, 100% { opacity: 1; }
				50% { opacity: 0.25; }
			}

			.stat-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
				column-gap: 20px;
				row-gap: 20px;
			}

			.stat {
				padding: 18px 20px;
				box-sizing: border-box;
			}

			.stat .label {
				font-size: 13px;
				text-transform: uppercase;
				letter-spacing: 1px;
				color: rgba(255, 255, 255, 0.5);
			}

			.stat .value {
				font-size: 30px;
				font-weight: bold;
				color: rgb(255, 255, 255);
				margin: 6px 0 2px;
			}

			.stat .value span {
				font-size: 16px;
				font-weight: normal;
				color: rgba(255, 255, 255, 0.5);
				margin-left: 4px;
			}

			.stat .detail {
				font-size: 13px;
				color: rgba(255, 255, 255, 0.55);
			}

			.bar {
				height: 6px;
				width: 100%;
				border-radius: 3px;
				background: rgba(255, 255, 255, 0.12);
				overflow: hidden;
				margin: 10px 0 8px;
			}

			.bar div {
				height: 100%;
				border-radius: 3px;
				background: var(--accent-color);
				transition: width 0.5s ease, background 0.5s ease;
			}

			.cores {
				display: flex;
				column-gap: 3px;
				margin-top: 10px;
				height: 26px;
				align-items: flex-end;
			}

			.cores div {
				flex: 1;
				background: var(--accent-color);
				border-radius: 2px;
				min-height: 2px;
				transition: height 0.5s ease;
			}

			.drive {
				padding: 16px 0;
				border-top: 1px solid rgba(255, 255, 255, 0.1);
			}

			.drive:first-of-type {
				border-top: none;
				padding-top: 0;
			}

			.drive .top {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				column-gap: 12px;
				flex-wrap: wrap;
			}

			.drive .mount {
				font-size: 17px;
				font-weight: bold;
				color: rgb(255, 255, 255);
			}

			.drive .model {
				font-size: 13px;
				color: rgba(255, 255, 255, 0.5);
				margin-left: 10px;
				font-weight: normal;
			}

			.drive .usage {
				font-size: 14px;
				color: rgba(255, 255, 255, 0.75);
				white-space: nowrap;
			}

			.badge {
				display: inline-block;
				padding: 3px 9px;
				border-radius: 20px;
				font-size: 11px;
				font-weight: bold;
				text-transform: uppercase;
				letter-spacing: 0.6px;
				vertical-align: middle;
			}

			.badge.healthy { background: rgba(80, 200, 130, 0.18); color: rgb(120, 225, 165); }
			.badge.warning { background: rgba(240, 180, 70, 0.18); color: rgb(245, 200, 110); }
			.badge.critical { background: rgba(250, 90, 90, 0.2); color: rgb(255, 130, 130); }
			.badge.unknown { background: rgba(255, 255, 255, 0.1); color: rgba(255, 255, 255, 0.5); }
			.badge.standby { background: rgba(120, 170, 255, 0.16); color: rgb(150, 190, 255); }
			.badge.neutral { background: rgba(255, 255, 255, 0.1); color: rgba(255, 255, 255, 0.6); }

			.chips {
				display: flex;
				flex-wrap: wrap;
				column-gap: 8px;
				row-gap: 8px;
				margin-top: 4px;
			}

			.chip {
				font-size: 12px;
				padding: 4px 10px;
				border-radius: 6px;
				background: rgba(255, 255, 255, 0.07);
				color: rgba(255, 255, 255, 0.7);
				white-space: nowrap;
			}

			.chip b {
				color: rgb(255, 255, 255);
				font-weight: bold;
			}

			.chip.alert {
				background: rgba(250, 90, 90, 0.18);
				color: rgb(255, 150, 150);
			}

			.reasons {
				font-size: 13px;
				color: rgb(255, 160, 160);
				margin-top: 8px;
			}

			.rows {
				display: flex;
				flex-direction: column;
				row-gap: 10px;
			}

			.row {
				display: flex;
				align-items: center;
				justify-content: space-between;
				column-gap: 12px;
				font-size: 14px;
				color: rgba(255, 255, 255, 0.75);
				flex-wrap: wrap;
			}

			.row .key {
				color: rgba(255, 255, 255, 0.55);
			}

			.row .val {
				color: rgb(255, 255, 255);
				text-align: right;
			}

			.two-column {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
				column-gap: 20px;
				row-gap: 20px;
			}

			.pill-list {
				display: flex;
				flex-wrap: wrap;
				column-gap: 8px;
				row-gap: 8px;
			}

			.pill {
				font-size: 12px;
				padding: 5px 10px;
				border-radius: 6px;
				background: rgba(255, 255, 255, 0.07);
				color: rgba(255, 255, 255, 0.75);
			}

			.pill.online { background: rgba(80, 200, 130, 0.15); color: rgb(130, 225, 170); }
			.pill.offline { background: rgba(250, 90, 90, 0.2); color: rgb(255, 140, 140); }

			.log {
				font-family: 'SF Mono', 'Menlo', 'Consolas', monospace;
				font-size: 11px;
				color: rgba(255, 255, 255, 0.45);
				white-space: nowrap;
				overflow-x: auto;
				margin-top: 6px;
			}

			.empty {
				font-size: 14px;
				color: rgba(255, 255, 255, 0.4);
			}

			@media screen and (max-width: 580px) {
				.server-wrapper { padding: 70px 12px 90px; }
				.stat .value { font-size: 26px; }
				.drive .model { margin-left: 0; display: block; }
			}
		</style>
</head>

<body class="page-server">
	<%- include('../partials/components/back'); %> <%- include('../partials/components/loading'); %> <%-
				include('../partials/components/menu'); %>
				<div class="server-wrapper">
					<div class="server-inner">
						<div class="glass panel server-header">
							<div>
								<div class="title" id="hostname">Server</div>
								<div class="subtitle" id="host-detail">Loading metrics...</div>
							</div>
							<div class="live" id="live">
								<div class="dot"></div>
								<span id="live-text">Live</span>
							</div>
						</div>

						<div class="stat-grid" id="stats"></div>

						<div class="glass panel">
							<h2>Drives <span class="count" id="drive-count"></span></h2>
							<div id="drives"><div class="empty">Loading...</div></div>
						</div>

						<div class="two-column">
							<div class="glass panel">
								<h2>Power &amp; Crash History</h2>
								<div class="rows" id="power"></div>
							</div>
							<div class="glass panel">
								<h2>Kernel Events <span class="count">this boot</span></h2>
								<div class="rows" id="events"></div>
							</div>
						</div>

						<div class="two-column">
							<div class="glass panel">
								<h2>Services <span class="count" id="service-count"></span></h2>
								<div class="pill-list" id="services"></div>
							</div>
							<div class="glass panel">
								<h2>Containers <span class="count" id="container-count"></span></h2>
								<div class="pill-list" id="containers"></div>
							</div>
						</div>
					</div>
				</div>
				<script src="/assets/js/device.js"></script>
				<script src="/assets/js/storage.js"></script>
				<script src="/assets/js/main.js"></script>
				<script src="/assets/js/caching.js"></script>
				<script src="/assets/js/background.js"></script>
				<script>
					(() => {
						const REFRESH_MS = 5000;

						function escapeHtml(value) {
							return String(value ?? '').replace(
								/[&<>"']/g,
								(char) =>
									({
										'&': '&amp;',
										'<': '&lt;',
										'>': '&gt;',
										'"': '&quot;',
										"'": '&#39;',
									})[char]
							);
						}

						function formatBytes(bytes) {
							const value = Number(bytes) || 0;
							const units = ['B', 'KB', 'MB', 'GB', 'TB', 'PB'];
							let index = 0;
							let result = value;
							while (result >= 1024 && index < units.length - 1) {
								result /= 1024;
								index += 1;
							}
							return `${result.toFixed(result >= 100 || index < 2 ? 0 : 1)} ${units[index]}`;
						}

						function formatDuration(seconds) {
							const total = Math.max(0, Math.floor(Number(seconds) || 0));
							const days = Math.floor(total / 86400);
							const hours = Math.floor((total % 86400) / 3600);
							const minutes = Math.floor((total % 3600) / 60);
							if (days > 0) return `${days}d ${hours}h ${minutes}m`;
							if (hours > 0) return `${hours}h ${minutes}m`;
							return `${minutes}m`;
						}

						function formatDate(value) {
							if (!value) return 'Unknown';
							const date = new Date(value);
							if (Number.isNaN(date.getTime())) return 'Unknown';
							return date.toLocaleString('en-GB', {
								day: '2-digit',
								month: 'short',
								year: 'numeric',
								hour: '2-digit',
								minute: '2-digit',
							});
						}

						function barColor(percent) {
							if (percent >= 90) return 'rgb(250, 90, 90)';
							if (percent >= 75) return 'rgb(240, 180, 70)';
							return 'var(--accent-color)';
						}

						function statCard(label, value, unit, detail, percent, extra) {
							const width = Math.min(100, Math.max(0, Number(percent) || 0));
							return `
								<div class="glass stat">
									<div class="label">${escapeHtml(label)}</div>
									<div class="value">${escapeHtml(value)}${unit ? `<span>${escapeHtml(unit)}</span>` : ''}</div>
									<div class="bar"><div style="width: ${width}%; background: ${barColor(width)}"></div></div>
									<div class="detail">${escapeHtml(detail)}</div>
									${extra ?? ''}
								</div>
							`;
						}

						function renderStats(data) {
							const memory = data.memory;
							const cpu = data.cpu;
							const hottest = data.temperatures?.[0];

							const cores = (cpu.cores ?? [])
								.map(
									(usage) =>
										`<div style="height: ${Math.max(4, Math.min(100, usage))}%; background: ${barColor(usage)}"></div>`
								)
								.join('');

							document.getElementById('stats').innerHTML = [
								statCard(
									'CPU',
									cpu.usage.toFixed(1),
									'%',
									`Load ${cpu.load.map((n) => n.toFixed(2)).join('  ')} over ${cpu.count} threads`,
									cpu.usage,
									`<div class="cores">${cores}</div>`
								),
								statCard(
									'Memory',
									formatBytes(memory.used),
									`of ${formatBytes(memory.total)}`,
									`${formatBytes(memory.available)} available, ${formatBytes(memory.cached)} cached`,
									memory.percent
								),
								statCard(
									'Swap',
									formatBytes(memory.swap.used),
									`of ${formatBytes(memory.swap.total)}`,
									memory.swap.used === 0 ? 'Nothing swapped out' : 'Swap in use',
									memory.swap.percent
								),
								statCard(
									'Temperature',
									hottest ? hottest.value.toFixed(0) : '--',
									'°C',
									hottest
										? `${hottest.label} is the hottest of ${data.temperatures.length} sensors`
										: 'No sensors reporting',
									hottest ? (hottest.value / 100) * 100 : 0
								),
							].join('');
						}

						function renderDrives(data) {
							const drives = data.drives ?? [];
							document.getElementById('drive-count').innerText = `${drives.length} mounted`;

							if (drives.length === 0) {
								document.getElementById('drives').innerHTML =
									'<div class="empty">No drives reported.</div>';
								return;
							}

							document.getElementById('drives').innerHTML = drives
								.map((drive) => {
									const attributes = drive.smart?.attributes ?? {};
									const chips = [];

									if (attributes.temperature !== undefined)
										chips.push(`<div class="chip">Temp <b>${attributes.temperature}°C</b></div>`);
									if (attributes.powerOnHours !== undefined)
										chips.push(
											`<div class="chip">Powered <b>${attributes.powerOnHours.toLocaleString()}h</b></div>`
										);
									if (attributes.percentageUsed !== undefined)
										chips.push(`<div class="chip">Endurance used <b>${attributes.percentageUsed}%</b></div>`);
									if (attributes.availableSpare !== undefined)
										chips.push(`<div class="chip">Spare <b>${attributes.availableSpare}%</b></div>`);
									if (attributes.wearLeveling !== undefined)
										chips.push(`<div class="chip">Wear level <b>${attributes.wearLeveling}</b></div>`);
									if (attributes.reallocatedSectors !== undefined)
										chips.push(
											`<div class="chip ${attributes.reallocatedSectors > 0 ? 'alert' : ''}">Reallocated <b>${attributes.reallocatedSectors}</b></div>`
										);
									if (attributes.pendingSectors !== undefined)
										chips.push(
											`<div class="chip ${attributes.pendingSectors > 0 ? 'alert' : ''}">Pending <b>${attributes.pendingSectors}</b></div>`
										);
									if (attributes.crcErrors !== undefined)
										chips.push(
											`<div class="chip ${attributes.crcErrors > 0 ? 'alert' : ''}">CRC errors <b>${attributes.crcErrors}</b></div>`
										);
									if (attributes.unsafeShutdowns !== undefined)
										chips.push(`<div class="chip">Unsafe stops <b>${attributes.unsafeShutdowns}</b></div>`);
									if (attributes.loadCycles !== undefined)
										chips.push(
											`<div class="chip">Load cycles <b>${attributes.loadCycles.toLocaleString()}</b></div>`
										);
									if (drive.filesystemErrors !== null && drive.filesystemErrors !== undefined)
										chips.push(
											`<div class="chip ${drive.filesystemErrors > 0 ? 'alert' : ''}">FS errors <b>${drive.filesystemErrors}</b></div>`
										);

									const reasons = drive.health?.reasons?.length
										? `<div class="reasons">${escapeHtml(drive.health.reasons.join(' / '))}</div>`
										: '';

									return `
										<div class="drive">
											<div class="top">
												<div>
													<span class="mount">${escapeHtml(drive.mount)}</span>
													<span class="model">${escapeHtml(drive.model)} · ${escapeHtml(drive.fstype)} · ${escapeHtml(drive.transport)}</span>
												</div>
												<div class="usage">
													${formatBytes(drive.used)} / ${formatBytes(drive.size)}
													<span class="badge ${escapeHtml(drive.health?.status ?? 'unknown')}">${escapeHtml(drive.health?.status ?? 'unknown')}</span>
												</div>
											</div>
											<div class="bar"><div style="width: ${Math.min(100, drive.percent)}%; background: ${barColor(drive.percent)}"></div></div>
											<div class="chips">
												<div class="chip">${drive.percent}% used, <b>${formatBytes(drive.avail)}</b> free</div>
												${chips.join('')}
											</div>
											${reasons}
										</div>
									`;
								})
								.join('');
						}

						function renderPower(data) {
							const power = data.power ?? {};
							const crash = power.lastCrash;
							const rows = [];

							rows.push(
								`<div class="row"><span class="key">Uptime</span><span class="val">${formatDuration(data.uptime.seconds)}</span></div>`
							);
							rows.push(
								`<div class="row"><span class="key">Booted</span><span class="val">${formatDate(data.uptime.bootedAt)}</span></div>`
							);
							rows.push(
								`<div class="row"><span class="key">Boots recorded</span><span class="val">${power.boots ?? 0}</span></div>`
							);

							const uncleanBadge =
								(power.uncleanCount ?? 0) > 0 ? 'warning' : 'healthy';
							rows.push(
								`<div class="row"><span class="key">Unclean shutdowns</span><span class="val"><span class="badge ${uncleanBadge}">${power.uncleanCount ?? 0}</span></span></div>`
							);

							if (crash) {
								rows.push(
									`<div class="row"><span class="key">Previous boot ended</span><span class="val">${formatDate(crash.previousBootEndedAt)}</span></div>`
								);
								rows.push(
									`<div class="row"><span class="key">Downtime before recovery</span><span class="val">${formatDuration(crash.downtimeSeconds)}</span></div>`
								);
							}

							const recent = power.uncleanShutdowns ?? [];
							if (recent.length > 0) {
								rows.push(
									`<div class="row"><span class="key">Last unclean recovery</span><span class="val">${formatDate(recent[0].recoveredAt)}</span></div>`
								);
							}

							document.getElementById('power').innerHTML = rows.join('');
						}

						function renderEvents(data) {
							const events = data.events ?? {};
							const keys = Object.keys(events);

							if (keys.length === 0) {
								document.getElementById('events').innerHTML =
									'<div class="empty">No event data.</div>';
								return;
							}

							document.getElementById('events').innerHTML = keys
								.map((key) => {
									const event = events[key];
									const badge = event.count > 0 ? 'warning' : 'healthy';
									const recent =
										event.count > 0 && event.recent?.length
											? `<div class="log">${escapeHtml(event.recent[event.recent.length - 1])}</div>`
											: '';
									return `
										<div>
											<div class="row">
												<span class="key">${escapeHtml(event.label)}</span>
												<span class="val"><span class="badge ${badge}">${event.count}</span></span>
											</div>
											${recent}
										</div>
									`;
								})
								.join('');
						}

						function renderServices(data) {
							const services = data.services ?? [];
							const containers = data.containers ?? [];

							document.getElementById('service-count').innerText =
								`${services.filter((s) => s.status === 'online').length}/${services.length} online`;
							document.getElementById('container-count').innerText =
								`${containers.filter((c) => c.state === 'running').length}/${containers.length} running`;

							document.getElementById('services').innerHTML =
								services.length === 0
									? '<div class="empty">No services reported.</div>'
									: services
											.map(
												(service) =>
													`<div class="pill ${service.status === 'online' ? 'online' : 'offline'}">${escapeHtml(service.name)}${service.restarts > 0 ? ` · ${service.restarts}↺` : ''}</div>`
											)
											.join('');

							document.getElementById('containers').innerHTML =
								containers.length === 0
									? '<div class="empty">No containers reported.</div>'
									: containers
											.map(
												(container) =>
													`<div class="pill ${container.state === 'running' ? 'online' : 'offline'}">${escapeHtml(container.name)}</div>`
											)
											.join('');
						}

						function render(data) {
							document.getElementById('hostname').innerText = data.host.hostname;
							document.getElementById('host-detail').innerText =
								`${data.host.platform} · ${data.cpu.model} · ${data.network.interface ?? 'no uplink'} ${data.network.address ?? ''}`;

							renderStats(data);
							renderDrives(data);
							renderPower(data);
							renderEvents(data);
							renderServices(data);
						}

						function setLive(ok, text) {
							const live = document.getElementById('live');
							live.classList.toggle('stale', !ok);
							document.getElementById('live-text').innerText = text;
						}

						async function refresh() {
							try {
								const response = await fetch('/server/stats', {
									credentials: 'same-origin',
								});

								if (response.status === 401) {
									window.location.href = '/error/401';
									return;
								}

								if (!response.ok) {
									setLive(false, 'Error');
									return;
								}

								const data = await response.json();
								render(data);
								setLive(true, `Updated ${new Date().toLocaleTimeString('en-GB')}`);
							} catch (error) {
								console.log(error);
								setLive(false, 'Disconnected');
							}
						}

						refresh();
						setInterval(refresh, REFRESH_MS);
					})();
				</script>
</body>

</html>
