<!DOCTYPE html>
<html lang="en" class="dark">
    <head>
        <title>Xtrendence | Server</title>
        <%- include('../partials/core/head-app'); %>
        <link rel="stylesheet" href="/assets/css/server.css" />
    </head>
    <body class="page-server<%= viewOnly ? ' view-only' : '' %>">
        <%- include('../partials/portfolio/chrome'); %> <%-
        include('../partials/portfolio/back'); %> <%-
        include('../partials/portfolio/dock'); %>

        <main class="app server-inner">
            <div class="card glass glass--lit server-header reveal">
                <div>
                    <div class="title">
                        <span class="health" id="health" role="img" aria-label="Health: all clear"></span>
                        <span id="hostname">Server</span>
                    </div>
                    <div class="subtitle" id="host-detail">Loading metrics...</div>
                </div>
                <div class="header-side">
                    <% if (viewOnly) { %>
                    <span class="view-banner" id="view-banner">View only</span>
                    <% } else { %>
                    <button class="btn btn--sm btn--ghost share-button" type="button" id="share-button">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 16a3 3 0 0 0-2.4 1.2l-6.7-3.4a3 3 0 0 0 0-1.6l6.7-3.4A3 3 0 1 0 15 7l-6.7 3.4a3 3 0 1 0 0 3.2L15 17a3 3 0 1 0 3-1Z" /></svg>
                        <span>Share</span>
                    </button>
                    <% } %>
                    <div class="live" id="live">
                        <div class="dot"></div>
                        <span id="live-text">Live</span>
                    </div>
                </div>
            </div>

            <div class="card glass glass--lit panel alerts reveal">
                <h2>Alerts <span class="count" id="alert-meta">Waiting for first check</span></h2>
                <div class="issues" id="issues"><div class="empty">No check has run yet.</div></div>

                <div class="rules-head">
                    <div>
                        <h3>Rules</h3>
                        <div class="rules-summary" id="rules-summary">Loading rules...</div>
                    </div>
                    <div class="rules-actions">
                        <button class="btn btn--sm btn--ghost action" type="button" id="run-check">
                            <span class="spinner"></span>
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4V1L8 5l4 4V6a6 6 0 1 1-6 6H4a8 8 0 1 0 8-8Z" /></svg>
                            <span class="action-label">Run check</span>
                        </button>
                        <button class="btn btn--sm btn--ghost action" type="button" id="send-notification">
                            <span class="spinner"></span>
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 22a2.5 2.5 0 0 0 2.45-2h-4.9A2.5 2.5 0 0 0 12 22Zm7-6V11a7 7 0 0 0-5.5-6.84V3.5a1.5 1.5 0 0 0-3 0v.66A7 7 0 0 0 5 11v5l-2 2v1h18v-1l-2-2Z" /></svg>
                            <span class="action-label">Send notification</span>
                        </button>
                        <button class="btn btn--sm btn--ghost rules-toggle" type="button" id="rules-toggle" aria-expanded="false" aria-controls="rules-body">
                            <span class="edit">Edit rules</span>
                            <span class="done">Done</span>
                        </button>
                    </div>
                </div>
                <div class="rules-body" id="rules-body" inert>
                    <div class="rules-inner">
                        <p class="rules-hint">Each indicator can stay quiet, raise a warning that turns the light purple, or raise a critical alert that turns it red. Checked every 5 minutes.</p>
                        <div class="rules" id="rules"><div class="empty">Loading rules...</div></div>
                        <div class="rules-foot">
                            <span class="rules-status" id="rules-status"></span>
                            <button class="btn btn--sm btn--ghost" type="button" id="rules-reset" disabled>Discard</button>
                            <button class="btn btn--sm btn--accent" type="button" id="rules-save" disabled>Save rules</button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="stat-grid" id="stats"></div>

            <div class="card glass glass--lit panel trends reveal">
                <div class="trends-head">
                    <h2>Trends <span class="count" id="trends-meta">Loading</span></h2>
                    <div class="range-tabs" role="tablist" aria-label="Time range" id="range-tabs">
                        <button type="button" role="tab" data-range="24h">24h</button>
                        <button type="button" role="tab" data-range="7d">7d</button>
                        <button type="button" role="tab" data-range="30d">30d</button>
                        <button type="button" role="tab" data-range="1y">1y</button>
                    </div>
                </div>
                <div class="chart-grid" id="chart-grid"></div>

                <h3 class="trends-sub">Drives <span class="count">usage and forecast</span></h3>
                <div class="drive-trends" id="drive-trends"><div class="empty">Collecting data...</div></div>

                <h3 class="trends-sub">Alert history <span class="count" id="timeline-count"></span></h3>
                <div class="alert-timeline" id="alert-timeline"><div class="empty">No alerts in this range.</div></div>
            </div>

            <div class="card glass glass--lit panel internet reveal">
                <div class="vpn-head">
                    <h2>Internet <span class="count" id="internet-meta"></span></h2>
                    <span class="badge unknown" id="internet-state">Loading</span>
                </div>
                <div class="uptime-tiles" id="uptime-tiles"></div>
                <div class="outage-strip" id="outage-strip"></div>
                <div class="outages" id="outage-list"></div>
            </div>

            <div class="card glass glass--lit panel reveal">
                <h2>Drives <span class="count" id="drive-count"></span></h2>
                <div id="drives"><div class="empty">Loading...</div></div>
            </div>

            <div class="two-column">
                <div class="card glass glass--lit panel reveal">
                    <h2>Power &amp; Uptime</h2>
                    <div class="rows" id="power"></div>
                </div>
                <div class="card glass glass--lit panel reveal">
                    <h2>Kernel Events <span class="count">this boot</span></h2>
                    <div class="rows" id="events"></div>
                </div>
            </div>

            <div class="two-column">
                <div class="card glass glass--lit panel reveal">
                    <h2>Services <span class="count" id="service-count"></span></h2>
                    <div class="pill-list" id="services"></div>
                </div>
                <div class="card glass glass--lit panel reveal">
                    <h2>Containers <span class="count" id="container-count"></span></h2>
                    <div class="pill-list" id="containers"></div>
                </div>
            </div>
            <div class="card glass glass--lit panel vpn reveal">
                <div class="vpn-head">
                    <h2>VPN <span class="count" id="vpn-count"></span></h2>
                    <div class="vpn-actions">
                        <span class="badge unknown" id="vpn-state">Loading</span>
                        <button class="btn btn--sm btn--ghost vpn-restart" type="button" id="vpn-restart">
                            <span class="spinner"></span>
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4V1L8 5l4 4V6a6 6 0 1 1-6 6H4a8 8 0 1 0 8-8Z" /></svg>
                            <span class="action-label">Restart</span>
                        </button>
                    </div>
                </div>
                <div class="peers" id="vpn-peers"><div class="empty">Loading...</div></div>
                <form class="vpn-new" id="vpn-new" autocomplete="off">
                    <input type="text" id="vpn-new-name" placeholder="New profile name" maxlength="27" aria-label="New profile name" />
                    <div class="levels tunnel-choice" role="radiogroup" aria-label="What the profile sends through the VPN">
                        <label class="level" title="Only home network traffic goes through the VPN">
                            <input type="radio" name="vpn-tunnel" value="lan" checked />
                            <span>LAN only</span>
                        </label>
                        <label class="level" title="Everything goes through home, so sites see the home IP. The LAN still works">
                            <input type="radio" name="vpn-tunnel" value="full" />
                            <span>All traffic</span>
                        </label>
                    </div>
                    <span class="vpn-new-status" id="vpn-new-status" role="status">Saved to Downloads/VPN Profiles</span>
                    <button class="btn btn--sm btn--accent" type="submit" id="vpn-new-submit">Add profile</button>
                </form>
            </div>
            <div class="card glass glass--lit panel backups reveal">
                <div class="backup-head">
                    <div class="backup-title">
                        <h2>Backups <span class="badge unknown" id="backup-state">Loading</span></h2>
                        <div class="backup-meta" id="backup-meta"></div>
                    </div>
                    <div class="backup-actions">
                        <button class="btn btn--sm btn--ghost action" type="button" id="backup-run">
                            <span class="spinner"></span>
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 20h14v-2H5v2Zm7-2 5-5h-3V4h-4v9H7l5 5Z" /></svg>
                            <span class="action-label">Back up now</span>
                        </button>
                        <button class="btn btn--sm btn--ghost rules-toggle" type="button" id="backup-toggle" aria-expanded="false" aria-controls="backup-body">
                            <span class="edit">Details</span>
                            <span class="done">Hide</span>
                        </button>
                    </div>
                </div>
                <div class="backup-note" id="backup-note" hidden></div>
                <div class="backup-body" id="backup-body" inert>
                    <div class="backup-inner">
                        <h3>Kept on <span id="backup-drive">the backup drive</span> <span class="count" id="backup-keep"></span></h3>
                        <div class="backup-list" id="backup-list"><div class="empty">No backups yet.</div></div>
                        <h3>What is backed up <span class="count" id="backup-source-count"></span></h3>
                        <p class="backup-hint">Each ZIP holds restore.sh and a bak folder. bak has everything in ~/Documents that git would not bring back (uncommitted changes, untracked files, and ignored files like .env, keys and databases), plus the system setup: crontab, fstab, the Cloudflare tunnel, Docker compose files and volumes, pm2 and home folder config. On a new server, put the ZIP in ~/Documents, extract restore.sh from it and run ./restore.sh.</p>
                        <div class="backup-sources" id="backup-sources"></div>
                    </div>
                </div>
            </div>
        </main>

        <% if (!viewOnly) { %>
        <dialog class="qr-dialog restart-dialog glass" id="restart-dialog" aria-labelledby="restart-title">
            <div class="qr-head">
                <div>
                    <span class="qr-eyebrow" id="restart-kind">Restart</span>
                    <h2 id="restart-title">Restart</h2>
                </div>
            </div>
            <div class="restart-facts" id="restart-facts"></div>
            <p class="restart-note" id="restart-note" hidden></p>
            <div class="qr-foot">
                <span class="qr-status" id="restart-status"></span>
                <button class="btn btn--sm btn--ghost" type="button" id="restart-cancel">Cancel</button>
                <button class="btn btn--sm btn--accent restart-confirm" type="button" id="restart-confirm">Restart</button>
            </div>
        </dialog>

        <dialog class="qr-dialog share-dialog glass" id="share-dialog" aria-labelledby="share-title">
            <div class="qr-head">
                <div>
                    <span class="qr-eyebrow">View-only link</span>
                    <h2 id="share-title">Share code</h2>
                </div>
                <button class="btn btn--sm btn--ghost" type="button" id="share-close">Close</button>
            </div>
            <p class="share-intro">Anyone with this code or link can see this page for 8 hours, but cannot change anything, see VPN QR codes, or see what the backups contain.</p>
            <div class="share-pin" id="share-pin">----</div>
            <div class="share-link">
                <code id="share-url"></code>
                <button class="btn btn--sm btn--ghost" type="button" id="share-copy">Copy link</button>
            </div>
            <div class="qr-foot">
                <span class="qr-status" id="share-status"></span>
                <button class="btn btn--sm btn--ghost" type="button" id="share-stop">Stop all sharing</button>
                <button class="btn btn--sm btn--accent" type="button" id="share-new">New code</button>
            </div>
        </dialog>
        <% } %>

        <dialog class="qr-dialog glass" id="qr-dialog" aria-labelledby="qr-title">
            <div class="qr-head">
                <div>
                    <span class="qr-eyebrow">VPN profile</span>
                    <h2 id="qr-title">Profile</h2>
                </div>
                <button class="btn btn--sm btn--ghost" type="button" id="qr-close">Close</button>
            </div>
            <form class="qr-unlock" id="qr-unlock" autocomplete="off">
                <p>The QR code holds this profile's private key. Enter the server password to show it.</p>
                <input type="password" id="qr-password" placeholder="Server password" aria-label="Server password" autocomplete="current-password" />
                <div class="qr-foot">
                    <span class="qr-status" id="qr-status" role="status"></span>
                    <button class="btn btn--sm btn--accent" type="submit" id="qr-submit">Show QR</button>
                </div>
            </form>
            <div class="qr-view" id="qr-view" hidden>
                <img id="qr-image" alt="WireGuard QR code" />
                <span class="qr-status" id="qr-timer"></span>
            </div>
        </dialog>

        <script>
            window.SERVER_VIEW_ONLY = <%- JSON.stringify(Boolean(viewOnly)) %>;
            window.SERVER_VIEW_EXPIRES = <%- JSON.stringify(viewExpiresAt) %>;
            window.SERVER_APP_NAME = <%- JSON.stringify(typeof appName === 'undefined' ? null : appName) %>;
        </script>
        <script src="/assets/js/device.js"></script>
        <script src="/assets/js/main.js"></script>
        <script src="/assets/js/storage.js"></script>
        <script src="/assets/js/app.js"></script>
        <script src="/assets/js/server-history.js" defer></script>

    	<script>
    		(() => {
    			const REFRESH_MS = 5000;

    			function escapeHtml(value) {
    				return String(value ?? '').replace(
    					/[&<>"']/g,
    					(char) =>
    						({
    							'&': '&amp;',
    							'<': '&lt;',
    							'>': '&gt;',
    							'"': '&quot;',
    							"'": '&#39;',
    						})[char]
    				);
    			}

    			// The live refresh redraws every section every few seconds. Skipping the
    			// ones that did not change keeps glass cards from being torn down and
    			// rebuilt, which is expensive, and keeps hover states from flickering
    			function html(id) {
    				const element = document.getElementById(id);
    				return {
    					set value(markup) {
    						if (element.__markup === markup) return;
    						element.__markup = markup;
    						element.innerHTML = markup;
    					},
    				};
    			}

    			function formatBytes(bytes) {
    				const value = Number(bytes) || 0;
    				const units = ['B', 'KB', 'MB', 'GB', 'TB', 'PB'];
    				let index = 0;
    				let result = value;
    				while (result >= 1024 && index < units.length - 1) {
    					result /= 1024;
    					index += 1;
    				}
    				return `${result.toFixed(result >= 100 || index < 2 ? 0 : 1)} ${units[index]}`;
    			}

    			function formatDuration(seconds) {
    				const total = Math.max(0, Math.floor(Number(seconds) || 0));
    				const days = Math.floor(total / 86400);
    				const hours = Math.floor((total % 86400) / 3600);
    				const minutes = Math.floor((total % 3600) / 60);
    				if (days > 0) return `${days}d ${hours}h ${minutes}m`;
    				if (hours > 0) return `${hours}h ${minutes}m`;
    				return `${minutes}m`;
    			}

    			function formatDate(value) {
    				if (!value) return 'Unknown';
    				const date = new Date(value);
    				if (Number.isNaN(date.getTime())) return 'Unknown';
    				return date.toLocaleString('en-GB', {
    					day: '2-digit',
    					month: 'short',
    					year: 'numeric',
    					hour: '2-digit',
    					minute: '2-digit',
    				});
    			}

    			function barColor(percent) {
    				if (percent >= 90) return 'var(--bar-critical)';
    				if (percent >= 75) return 'var(--bar-warning)';
    				return 'var(--bar-healthy)';
    			}

    			function statCard(label, value, unit, detail, percent, extra) {
    				const width = Math.min(100, Math.max(0, Number(percent) || 0));
    				return `
    					<div class="glass stat">
    						<div class="label">${escapeHtml(label)}</div>
    						<div class="value">${escapeHtml(value)}${unit ? `<span>${escapeHtml(unit)}</span>` : ''}</div>
    						<div class="bar"><div style="width: ${width}%; background: ${barColor(width)}"></div></div>
    						<div class="detail">${escapeHtml(detail)}</div>
    						${extra ?? ''}
    					</div>
    				`;
    			}

    			function renderStats(data) {
    				const memory = data.memory;
    				const cpu = data.cpu;
    				const hottest = data.temperatures?.[0];

    				const cores = (cpu.cores ?? [])
    					.map(
    						(usage) =>
    							`<div style="height: ${Math.max(4, Math.min(100, usage))}%; background: ${barColor(usage)}"></div>`
    					)
    					.join('');

    				html('stats').value = [
    					statCard(
    						'CPU',
    						cpu.usage.toFixed(1),
    						'%',
    						`Load ${cpu.load.map((n) => n.toFixed(2)).join('  ')} over ${cpu.count} threads`,
    						cpu.usage,
    						`<div class="cores">${cores}</div>`
    					),
    					statCard(
    						'Memory',
    						formatBytes(memory.used),
    						`of ${formatBytes(memory.total)}`,
    						`${formatBytes(memory.available)} available, ${formatBytes(memory.cached)} cached`,
    						memory.percent
    					),
    					statCard(
    						'Swap',
    						formatBytes(memory.swap.used),
    						`of ${formatBytes(memory.swap.total)}`,
    						memory.swap.used === 0 ? 'Nothing swapped out' : 'Swap in use',
    						memory.swap.percent
    					),
    					statCard(
    						'Temperature',
    						hottest ? hottest.value.toFixed(0) : '--',
    						'°C',
    						hottest
    							? `${hottest.label} is the hottest of ${data.temperatures.length} sensors`
    							: 'No sensors reporting',
    						hottest ? (hottest.value / 100) * 100 : 0
    					),
    				].join('');
    			}

    			function renderDrives(data) {
    				const drives = data.drives ?? [];
    				document.getElementById('drive-count').innerText = `${drives.length} mounted`;

    				if (drives.length === 0) {
    					html('drives').value =
    						'<div class="empty">No drives reported.</div>';
    					return;
    				}

    				html('drives').value = drives
    					.map((drive) => {
    						const attributes = drive.smart?.attributes ?? {};
    						const chips = [];

    						if (attributes.temperature !== undefined)
    							chips.push(`<div class="chip">Temp <b>${attributes.temperature}°C</b></div>`);
    						if (attributes.powerOnHours !== undefined)
    							chips.push(
    								`<div class="chip">Powered <b>${attributes.powerOnHours.toLocaleString()}h</b></div>`
    							);
    						if (attributes.percentageUsed !== undefined)
    							chips.push(`<div class="chip">Endurance used <b>${attributes.percentageUsed}%</b></div>`);
    						if (attributes.availableSpare !== undefined)
    							chips.push(`<div class="chip">Spare <b>${attributes.availableSpare}%</b></div>`);
    						if (attributes.wearLeveling !== undefined)
    							chips.push(`<div class="chip">Wear level <b>${attributes.wearLeveling}</b></div>`);
    						if (attributes.reallocatedSectors !== undefined)
    							chips.push(
    								`<div class="chip ${attributes.reallocatedSectors > 0 ? 'alert' : ''}">Reallocated <b>${attributes.reallocatedSectors}</b></div>`
    							);
    						if (attributes.pendingSectors !== undefined)
    							chips.push(
    								`<div class="chip ${attributes.pendingSectors > 0 ? 'alert' : ''}">Pending <b>${attributes.pendingSectors}</b></div>`
    							);
    						if (attributes.crcErrors !== undefined)
    							chips.push(
    								`<div class="chip ${attributes.crcErrors > 0 ? 'alert' : ''}">CRC errors <b>${attributes.crcErrors}</b></div>`
    							);
    						if (attributes.unsafeShutdowns !== undefined)
    							chips.push(`<div class="chip">Unsafe stops <b>${attributes.unsafeShutdowns}</b></div>`);
    						if (attributes.loadCycles !== undefined)
    							chips.push(
    								`<div class="chip">Load cycles <b>${attributes.loadCycles.toLocaleString()}</b></div>`
    							);
    						if (drive.filesystemErrors !== null && drive.filesystemErrors !== undefined)
    							chips.push(
    								`<div class="chip ${drive.filesystemErrors > 0 ? 'alert' : ''}">FS errors <b>${drive.filesystemErrors}</b></div>`
    							);

    						const reasons = drive.health?.reasons?.length
    							? `<div class="reasons">${escapeHtml(drive.health.reasons.join(' / '))}</div>`
    							: '';

    						return `
    							<div class="drive">
    								<div class="top">
    									<div>
    										<span class="mount">${escapeHtml(drive.mount)}</span>
    										<span class="model">${escapeHtml(drive.model)} · ${escapeHtml(drive.fstype)} · ${escapeHtml(drive.transport)}</span>
    									</div>
    									<div class="usage">
    										${formatBytes(drive.used)} / ${formatBytes(drive.size)}
    										<span class="badge ${escapeHtml(drive.health?.status ?? 'unknown')}">${escapeHtml(drive.health?.status ?? 'unknown')}</span>
    									</div>
    								</div>
    								<div class="bar"><div style="width: ${Math.min(100, drive.percent)}%; background: ${barColor(drive.percent)}"></div></div>
    								<div class="chips">
    									<div class="chip">${drive.percent}% used, <b>${formatBytes(drive.avail)}</b> free</div>
    									${chips.join('')}
    								</div>
    								${reasons}
    							</div>
    						`;
    					})
    					.join('');
    			}

    			function renderPower(data) {
    				const power = data.power ?? {};
    				const crash = power.lastCrash;
    				const rows = [];

    				rows.push(
    					`<div class="row"><span class="key">Uptime</span><span class="val">${formatDuration(data.uptime.seconds)}</span></div>`
    				);
    				rows.push(
    					`<div class="row"><span class="key">Booted</span><span class="val">${formatDate(data.uptime.bootedAt)}</span></div>`
    				);
    				rows.push(
    					`<div class="row"><span class="key">Boots recorded</span><span class="val">${power.boots ?? 0}</span></div>`
    				);

    				const uncleanBadge =
    					(power.uncleanCount ?? 0) > 0 ? 'warning' : 'healthy';
    				rows.push(
    					`<div class="row"><span class="key">Unclean shutdowns</span><span class="val"><span class="badge ${uncleanBadge}">${power.uncleanCount ?? 0}</span></span></div>`
    				);

    				if (crash) {
    					rows.push(
    						`<div class="row"><span class="key">Previous boot ended</span><span class="val">${formatDate(crash.previousBootEndedAt)}</span></div>`
    					);
    					rows.push(
    						`<div class="row"><span class="key">Downtime before recovery</span><span class="val">${formatDuration(crash.downtimeSeconds)}</span></div>`
    					);
    				}

    				const recent = power.uncleanShutdowns ?? [];
    				if (recent.length > 0) {
    					rows.push(
    						`<div class="row"><span class="key">Last unclean recovery</span><span class="val">${formatDate(recent[0].recoveredAt)}</span></div>`
    					);
    				}

    				html('power').value = rows.join('');
    			}

    			function renderEvents(data) {
    				const events = data.events ?? {};
    				const keys = Object.keys(events);

    				if (keys.length === 0) {
    					html('events').value =
    						'<div class="empty">No event data.</div>';
    					return;
    				}

    				html('events').value = keys
    					.map((key) => {
    						const event = events[key];
    						const badge = event.count > 0 ? 'warning' : 'healthy';
    						const recent =
    							event.count > 0 && event.recent?.length
    								? `<div class="log">${escapeHtml(event.recent[event.recent.length - 1])}</div>`
    								: '';
    						return `
    							<div>
    								<div class="row">
    									<span class="key">${escapeHtml(event.label)}</span>
    									<span class="val"><span class="badge ${badge}">${event.count}</span></span>
    								</div>
    								${recent}
    							</div>
    						`;
    					})
    					.join('');
    			}

    			let lastStats = null;

    			function renderServices(data) {
    				lastStats = data;
    				const services = data.services ?? [];
    				const containers = data.containers ?? [];

    				document.getElementById('service-count').innerText =
    					`${services.filter((s) => s.status === 'online').length}/${services.length} online`;
    				document.getElementById('container-count').innerText =
    					`${containers.filter((c) => c.state === 'running').length}/${containers.length} running`;

    				html('services').value =
    					services.length === 0
    						? '<div class="empty">No services reported.</div>'
    						: services
    								.map(
    									(service) =>
    										`<button class="pill pill--action ${service.status === 'online' ? 'online' : 'offline'}" type="button" data-kind="service" data-name="${escapeHtml(service.name)}" title="Restart ${escapeHtml(service.name)}">${escapeHtml(service.name)}${service.restarts > 0 ? ` · ${service.restarts}↺` : ''}</button>`
    								)
    								.join('');

    				html('containers').value =
    					containers.length === 0
    						? '<div class="empty">No containers reported.</div>'
    						: containers
    								.map(
    									(container) =>
    										`<button class="pill pill--action ${container.state === 'running' ? 'online' : 'offline'}" type="button" data-kind="container" data-name="${escapeHtml(container.name)}" title="Restart ${escapeHtml(container.name)}">${escapeHtml(container.name)}</button>`
    								)
    								.join('');
    			}

    			const LEVEL_NAMES = { ok: 'All clear', soft: 'Warning', hard: 'Critical' };

    			function renderAlerts(alerts) {
    				if (!alerts) return;

    				const health = document.getElementById('health');
    				health.dataset.level = alerts.level;
    				health.setAttribute('aria-label', `Health: ${LEVEL_NAMES[alerts.level] ?? alerts.level}`);
    				health.title = alerts.issues.length
    					? alerts.issues.map((issue) => issue.message).join('\n')
    					: 'All clear';

    				if (!alerts.checkedAt) return;

    				const time = new Date(alerts.checkedAt).toLocaleTimeString('en-GB', {
    					hour: '2-digit',
    					minute: '2-digit',
    				});
    				const delivery = alerts.delivered?.ok
    					? 'light updated'
    					: (alerts.delivered?.error ?? 'light not updated');
    				document.getElementById('alert-meta').innerText = `Checked ${time} · ${delivery}`;

    				html('issues').value = alerts.issues.length
    					? alerts.issues
    							.map(
    								(issue) => `
    									<div class="issue ${escapeHtml(issue.level)}">
    										<span class="issue-level">${issue.level === 'hard' ? 'Critical' : 'Warning'}</span>
    										<span class="issue-label">${escapeHtml(issue.label)}</span>
    										<span class="issue-message">${escapeHtml(issue.message)}</span>
    									</div>
    								`
    							)
    							.join('')
    					: '<div class="all-clear">Nothing needs attention, the light is off.</div>';
    			}

    			let savedRules = null;

    			function rulesPayload() {
    				const payload = {};
    				for (const row of document.querySelectorAll('#rules .rule')) {
    					const id = row.dataset.id;
    					const level = row.querySelector('input[type="radio"]:checked')?.value ?? 'off';
    					const threshold = row.querySelector('input[type="number"]');
    					payload[id] = threshold ? { level, threshold: Number(threshold.value) } : { level };
    					if (row.querySelector('.rule-list')) {
    						payload[id].names = [...row.querySelectorAll('.rule-list input:checked')]
    							.map((input) => input.value)
    							.sort();
    					}
    				}
    				return payload;
    			}

    			function rulesFromList(rules) {
    				const payload = {};
    				for (const rule of rules) {
    					payload[rule.id] =
    						rule.threshold === undefined
    							? { level: rule.level }
    							: { level: rule.level, threshold: rule.threshold };
    					if (rule.list) {
    						payload[rule.id].names = [...rule.names].sort();
    					}
    				}
    				return payload;
    			}

    			function updateRulesState(message) {
    				const dirty = savedRules && JSON.stringify(rulesPayload()) !== JSON.stringify(savedRules);
    				document.getElementById('rules-save').disabled = !dirty;
    				document.getElementById('rules-reset').disabled = !dirty;

    				for (const row of document.querySelectorAll('#rules .rule')) {
    					row.dataset.level = row.querySelector('input[type="radio"]:checked')?.value ?? 'off';
    				}

    				const status = document.getElementById('rules-status');
    				status.classList.toggle('is-error', Boolean(message?.error));
    				status.innerText = message?.text ?? (dirty ? 'Unsaved changes' : '');

    				renderRulesSummary(dirty);
    			}

    			// The collapsed view still says what is being watched at a glance
    			function renderRulesSummary(dirty) {
    				const counts = { hard: 0, soft: 0, off: 0 };
    				for (const rule of Object.values(rulesPayload())) {
    					counts[rule.level] = (counts[rule.level] ?? 0) + 1;
    				}

    				document.getElementById('rules-summary').innerHTML = `
    					<span class="tally hard">${counts.hard} red</span>
    					<span class="tally soft">${counts.soft} purple</span>
    					<span class="tally off">${counts.off} off</span>
    					${dirty ? '<span class="tally unsaved">Unsaved changes</span>' : ''}
    				`;
    			}

    			const RULES_OPEN_KEY = 'server-rules-open';

    			function setRulesOpen(open) {
    				const body = document.getElementById('rules-body');
    				const toggle = document.getElementById('rules-toggle');
    				body.classList.toggle('open', open);
    				body.inert = !open;
    				toggle.classList.toggle('open', open);
    				toggle.setAttribute('aria-expanded', String(open));
    				try {
    					localStorage.setItem(RULES_OPEN_KEY, open ? '1' : '0');
    				} catch {}
    			}

    			// The label reports the outcome for a moment, then goes back
    			async function runAction(button, request, doneText) {
    				const label = button.querySelector('.action-label');
    				const idle = label.dataset.idle ?? label.innerText;
    				label.dataset.idle = idle;

    				button.disabled = true;
    				button.classList.add('loading');

    				let text = doneText;
    				let failed = false;
    				try {
    					const response = await fetch(request.url, {
    						method: 'POST',
    						credentials: 'same-origin',
    					});
    					const data = await response.json().catch(() => ({}));
    					if (!response.ok) throw new Error(data?.error ?? `HTTP ${response.status}`);
    					if (data.status) renderAlerts(data.status);
    				} catch (error) {
    					console.log(error);
    					text = 'Failed';
    					failed = true;
    					button.title = error.message;
    				}

    				button.classList.remove('loading');
    				button.classList.toggle('is-failed', failed);
    				label.innerText = text;

    				setTimeout(() => {
    					label.innerText = idle;
    					button.disabled = false;
    					button.classList.remove('is-failed');
    					button.removeAttribute('title');
    				}, 2500);
    			}

    			document.getElementById('run-check').addEventListener('click', (event) =>
    				runAction(event.currentTarget, { url: '/server/alerts/check' }, 'Checked')
    			);
    			document.getElementById('send-notification').addEventListener('click', (event) =>
    				runAction(event.currentTarget, { url: '/server/alerts/notify' }, 'Sent')
    			);

    			document.getElementById('rules-toggle').addEventListener('click', () => {
    				setRulesOpen(!document.getElementById('rules-body').classList.contains('open'));
    			});

    			try {
    				if (localStorage.getItem(RULES_OPEN_KEY) === '1') setRulesOpen(true);
    			} catch {}

    			// Picked names that no longer exist still show, so they can be removed
    			function listChips(rule, choices) {
    				const available = choices?.[rule.list.source] ?? [];
    				const names = [...new Set([...available, ...rule.names])].sort((a, b) =>
    					a.localeCompare(b, undefined, { numeric: true })
    				);
    				if (names.length === 0) return '';

    				const mode = rule.list.label === 'Ignore' ? 'ignore' : 'watch';
    				const chips = names
    					.map(
    						(name) => `
    							<label class="pick pick--${mode}">
    								<input type="checkbox" value="${escapeHtml(name)}" ${rule.names.includes(name) ? 'checked' : ''} />
    								<span>${escapeHtml(name)}</span>
    							</label>
    						`
    					)
    					.join('');

    				return `
    					<div class="rule-list">
    						<span class="rule-list-label">${escapeHtml(rule.list.label)}</span>
    						${chips}
    					</div>
    				`;
    			}

    			function renderRules(rules, choices) {
    				savedRules = rulesFromList(rules);

    				document.getElementById('rules').innerHTML = rules
    					.map((rule) => {
    						const name = `rule-${escapeHtml(rule.id)}`;
    						const levels = [
    							['off', 'Off'],
    							['soft', 'Purple'],
    							['hard', 'Red'],
    						]
    							.map(
    								([value, label]) => `
    									<label class="level level--${value}">
    										<input type="radio" name="${name}" value="${value}" ${rule.level === value ? 'checked' : ''} />
    										<span>${label}</span>
    									</label>
    								`
    							)
    							.join('');

    						const threshold =
    							rule.threshold === undefined
    								? '<span class="threshold threshold--none"></span>'
    								: `
    									<label class="threshold">
    										<input type="number" min="${rule.min}" max="${rule.max}" step="1" value="${rule.threshold}" aria-label="${escapeHtml(rule.label)} threshold" />
    										<span>${escapeHtml(rule.unit)}</span>
    									</label>
    								`;

    						return `
    							<div class="rule" data-id="${escapeHtml(rule.id)}" data-level="${escapeHtml(rule.level)}">
    								<div class="rule-text">
    									<span class="rule-label">${escapeHtml(rule.label)}</span>
    									<span class="rule-hint">${escapeHtml(rule.hint)}</span>
    								</div>
    								${threshold}
    								<div class="levels" role="radiogroup" aria-label="${escapeHtml(rule.label)}">${levels}</div>
    								${rule.list ? listChips(rule, choices) : ''}
    							</div>
    						`;
    					})
    					.join('');

    				updateRulesState();
    			}

    			async function loadRules() {
    				try {
    					const response = await fetch('/server/alerts', { credentials: 'same-origin' });
    					if (!response.ok) throw new Error(`HTTP ${response.status}`);
    					const data = await response.json();
    					renderRules(data.rules, data.choices);
    					renderAlerts(data.status);
    				} catch (error) {
    					console.log(error);
    					document.getElementById('rules').innerHTML =
    						'<div class="empty">Could not load the alert rules.</div>';
    				}
    			}

    			async function saveRules() {
    				const button = document.getElementById('rules-save');
    				button.disabled = true;
    				updateRulesState({ text: 'Saving and running a check...' });

    				try {
    					const response = await fetch('/server/alerts', {
    						method: 'PUT',
    						credentials: 'same-origin',
    						headers: { 'Content-Type': 'application/json' },
    						body: JSON.stringify({ rules: rulesPayload() }),
    					});
    					const data = await response.json();
    					if (!response.ok) throw new Error(data?.error ?? `HTTP ${response.status}`);

    					renderRules(data.rules, data.choices);
    					renderAlerts(data.status);
    					updateRulesState({ text: 'Saved' });
    				} catch (error) {
    					button.disabled = false;
    					updateRulesState({ text: error.message, error: true });
    				}
    			}

    			const rulesElement = document.getElementById('rules');
    			rulesElement.addEventListener('input', () => updateRulesState());
    			rulesElement.addEventListener('change', () => updateRulesState());
    			document.getElementById('rules-save').addEventListener('click', saveRules);
    			document.getElementById('rules-reset').addEventListener('click', loadRules);

    			function timeAgo(value) {
    				if (!value) return 'Never connected';
    				const seconds = Math.max(0, (Date.now() - new Date(value).getTime()) / 1000);
    				if (seconds < 90) return 'Just now';
    				if (seconds < 3600) return `${Math.round(seconds / 60)} min ago`;
    				if (seconds < 86400) return `${Math.round(seconds / 3600)} h ago`;
    				return `${Math.round(seconds / 86400)} d ago`;
    			}

    			// WireGuard handshakes every two minutes while traffic flows, so a
    			// recent one is the closest thing it has to a connected flag
    			function peerLive(peer) {
    				return peer.lastHandshake && Date.now() - new Date(peer.lastHandshake).getTime() < 3 * 60 * 1000;
    			}

    			// The suffix is what makes a profile full or LAN only, so the tag reads it
    			function tunnelTag(name) {
    				if (/_FULL$/.test(name)) return '<span class="tunnel-tag full">Full</span>';
    				if (/_LAN$/.test(name)) return '<span class="tunnel-tag">LAN</span>';
    				return '';
    			}

    			function renderVpn(vpn) {
    				if (!vpn) return;

    				const state = document.getElementById('vpn-state');
    				const status = !vpn.installed ? 'missing' : vpn.up ? 'healthy' : 'critical';
    				state.className = `badge ${status}`;
    				state.innerText = !vpn.installed ? 'Not installed' : vpn.up ? `Up · UDP ${vpn.listenPort}` : 'Down';

    				const live = vpn.peers.filter(peerLive).length;
    				document.getElementById('vpn-count').innerText = `${live}/${vpn.peers.length} connected`;

    				html('vpn-peers').value = vpn.peers.length
    					? vpn.peers
    							.map(
    								(peer) => `
    									<div class="peer ${peerLive(peer) ? 'is-live' : ''}">
    										<div class="peer-row">
    											<span class="peer-name"><span class="peer-label" title="${escapeHtml(peer.name)}">${escapeHtml(peer.name)}</span>${tunnelTag(peer.name)}</span>
    											<span class="peer-address">${escapeHtml(peer.address ?? '')}</span>
    										</div>
    										<div class="peer-row">
    											<span class="peer-seen">${escapeHtml(timeAgo(peer.lastHandshake))}</span>
    											<span class="peer-traffic">↓ ${formatBytes(peer.sent)} · ↑ ${formatBytes(peer.received)}</span>
    										</div>
    										${
    											peer.id
    												? `<div class="peer-buttons">
    														<button class="peer-qr" type="button" data-id="${escapeHtml(peer.id)}" data-name="${escapeHtml(peer.name)}" aria-label="Show the QR code for ${escapeHtml(peer.name)}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 3h8v8H3V3Zm2 2v4h4V5H5Zm8-2h8v8h-8V3Zm2 2v4h4V5h-4ZM3 13h8v8H3v-8Zm2 2v4h4v-4H5Zm8-2h2v2h-2v-2Zm2 2h2v2h-2v-2Zm-2 2h2v2h-2v-2Zm2 2h2v2h-2v-2Zm2-2h2v2h-2v-2Zm0-4h2v2h-2v-2Zm2 2h2v2h-2v-2Zm0 4h2v2h-2v-2Z" /></svg><span>Show QR</span></button>
    														<button class="peer-remove" type="button" data-id="${escapeHtml(peer.id)}" aria-label="Remove ${escapeHtml(peer.name)}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm0 2a8 8 0 0 1 6.32 12.9L7.1 5.68A7.96 7.96 0 0 1 12 4Zm-6.32 3.1L16.9 18.32A8 8 0 0 1 5.68 7.1Z" /></svg><span>Remove</span></button>
    													</div>`
    												: ''
    										}
    									</div>
    								`
    							)
    							.join('')
    					: '<div class="empty">No profiles.</div>';
    			}

    			// Two taps so a stray click cannot drop every connected device
    			const vpnRestart = document.getElementById('vpn-restart');
    			let vpnArmed = null;

    			vpnRestart.addEventListener('click', async () => {
    				const label = vpnRestart.querySelector('.action-label');

    				if (!vpnArmed) {
    					label.innerText = 'Tap to confirm';
    					vpnRestart.classList.add('is-armed');
    					vpnArmed = setTimeout(() => {
    						vpnArmed = null;
    						label.innerText = 'Restart';
    						vpnRestart.classList.remove('is-armed');
    					}, 4000);
    					return;
    				}

    				clearTimeout(vpnArmed);
    				vpnArmed = null;
    				vpnRestart.classList.remove('is-armed');
    				label.innerText = 'Restart';

    				await runAction(vpnRestart, { url: '/server/vpn/restart' }, 'Restarted');
    				refresh();
    			});

    			// Stats refresh every few seconds, so an armed button would be wiped
    			// by the next render. Rendering pauses while one is armed
    			let peerArmed = null;

    			function disarmPeer() {
    				if (!peerArmed) return;
    				clearTimeout(peerArmed.timer);
    				peerArmed.button.classList.remove('is-armed');
    				peerArmed.button.querySelector('span').innerText = 'Remove';
    				peerArmed = null;
    			}

    			const QR_VISIBLE_SECONDS = 60;
    			const qrDialog = document.getElementById('qr-dialog');
    			let qrProfile = null;
    			let qrTimer = null;

    			// Everything the key touched is cleared on close, not just hidden
    			function closeQr() {
    				clearInterval(qrTimer);
    				qrTimer = null;
    				qrProfile = null;
    				document.getElementById('qr-image').removeAttribute('src');
    				document.getElementById('qr-password').value = '';
    				document.getElementById('qr-status').innerText = '';
    				if (qrDialog.open) qrDialog.close();
    			}

    			function openQr(id, name) {
    				closeQr();
    				qrProfile = id;
    				document.getElementById('qr-title').innerText = name;
    				document.getElementById('qr-unlock').hidden = false;
    				document.getElementById('qr-view').hidden = true;
    				qrDialog.showModal();
    				document.getElementById('qr-password').focus({ preventScroll: true });
    			}

    			document.getElementById('qr-close').addEventListener('click', closeQr);
    			qrDialog.addEventListener('close', closeQr);
    			qrDialog.addEventListener('click', (event) => {
    				if (event.target === qrDialog) closeQr();
    			});

    			document.getElementById('qr-unlock').addEventListener('submit', async (event) => {
    				event.preventDefault();
    				const input = document.getElementById('qr-password');
    				const status = document.getElementById('qr-status');
    				const submit = document.getElementById('qr-submit');
    				if (!qrProfile || !input.value) return;

    				submit.disabled = true;
    				status.classList.remove('is-error');
    				status.innerText = 'Checking...';

    				try {
    					const response = await fetch(`/server/vpn/profiles/${encodeURIComponent(qrProfile)}/qr`, {
    						method: 'POST',
    						credentials: 'same-origin',
    						headers: { 'Content-Type': 'application/json' },
    						body: JSON.stringify({ password: input.value }),
    					});
    					const data = await response.json();
    					if (!response.ok) throw new Error(data?.error ?? `HTTP ${response.status}`);

    					input.value = '';
    					// As an image rather than inline markup, so nothing in the SVG can run
    					document.getElementById('qr-image').src =
    						`data:image/svg+xml;base64,${btoa(unescape(encodeURIComponent(data.svg)))}`;
    					document.getElementById('qr-unlock').hidden = true;
    					document.getElementById('qr-view').hidden = false;

    					let remaining = QR_VISIBLE_SECONDS;
    					const timer = document.getElementById('qr-timer');
    					timer.innerText = `Hides in ${remaining}s`;
    					qrTimer = setInterval(() => {
    						remaining -= 1;
    						timer.innerText = `Hides in ${remaining}s`;
    						if (remaining <= 0) closeQr();
    					}, 1000);
    				} catch (error) {
    					status.classList.add('is-error');
    					status.innerText = error.message;
    					input.select();
    				}

    				submit.disabled = false;
    			});

    			document.getElementById('vpn-peers').addEventListener('click', async (event) => {
    				const qrButton = event.target.closest('.peer-qr');
    				if (qrButton) {
    					disarmPeer();
    					openQr(qrButton.dataset.id, qrButton.dataset.name);
    					return;
    				}

    				const button = event.target.closest('.peer-remove');
    				if (!button) return;

    				if (peerArmed?.button !== button) {
    					disarmPeer();
    					button.classList.add('is-armed');
    					button.querySelector('span').innerText = 'Tap to revoke';
    					peerArmed = { button, timer: setTimeout(disarmPeer, 4000) };
    					return;
    				}

    				clearTimeout(peerArmed.timer);
    				peerArmed = null;
    				button.disabled = true;
    				button.querySelector('span').innerText = 'Revoking...';

    				try {
    					const response = await fetch(`/server/vpn/profiles/${encodeURIComponent(button.dataset.id)}`, {
    						method: 'DELETE',
    						credentials: 'same-origin',
    					});
    					const data = await response.json();
    					if (!response.ok) throw new Error(data?.error ?? `HTTP ${response.status}`);
    					renderVpn(data.vpn);
    				} catch (error) {
    					button.disabled = false;
    					button.querySelector('span').innerText = 'Failed';
    					button.title = error.message;
    				}
    			});

    			document.getElementById('vpn-new').addEventListener('submit', async (event) => {
    				event.preventDefault();
    				const input = document.getElementById('vpn-new-name');
    				const button = document.getElementById('vpn-new-submit');
    				const status = document.getElementById('vpn-new-status');
    				const name = input.value.trim();
    				if (!name) {
    					input.focus({ preventScroll: true });
    					return;
    				}

    				button.disabled = true;
    				status.classList.remove('is-error');
    				status.innerText = 'Creating...';

    				try {
    					const tunnel = document.querySelector('input[name="vpn-tunnel"]:checked')?.value ?? 'lan';
    					const response = await fetch('/server/vpn/profiles', {
    						method: 'POST',
    						credentials: 'same-origin',
    						headers: { 'Content-Type': 'application/json' },
    						body: JSON.stringify({ name, tunnel }),
    					});
    					const data = await response.json();
    					if (!response.ok) throw new Error(data?.error ?? `HTTP ${response.status}`);
    					input.value = '';
    					status.innerText = `${data.created} saved to Downloads/VPN Profiles`;
    					renderVpn(data.vpn);
    				} catch (error) {
    					status.classList.add('is-error');
    					status.innerText = error.message;
    				}

    				button.disabled = false;
    			});

    			function formatWhen(value) {
    				if (!value) return 'never';
    				return new Date(value).toLocaleString('en-GB', {
    					weekday: 'short',
    					day: 'numeric',
    					month: 'short',
    					hour: '2-digit',
    					minute: '2-digit',
    				});
    			}

    			let backupPoll = null;

    			function renderBackups(status) {
    				const state = document.getElementById('backup-state');
    				const running = status.running;

    				if (running) {
    					state.className = 'badge standby';
    					state.innerText = 'Backing up';
    				} else {
    					state.className = `badge ${status.health.ok ? 'healthy' : 'critical'}`;
    					state.innerText = status.health.ok ? 'All valid' : 'Problem';
    				}

    				const latest = status.backups[0];
    				const parts = [];
    				if (running) {
    					parts.push(
    						`${escapeHtml(running.phase)}${running.files ? `, ${running.files.toLocaleString()} files` : ''}`
    					);
    				} else if (!status.health.ok) {
    					parts.push(`<span class="backup-problem">${escapeHtml(status.health.reason)}</span>`);
    				}
    				parts.push(
    					latest
    						? `Last ${escapeHtml(formatWhen(latest.startedAt))} · ${formatBytes(latest.zipBytes)} · ${(latest.fileCount ?? 0).toLocaleString()} files`
    						: 'No backup yet'
    				);
    				parts.push(`Next ${escapeHtml(formatWhen(status.nextScheduled))}`);
    				document.getElementById('backup-meta').innerHTML = parts.join('<span class="dot-sep">·</span>');

    				// Says up front what a manual run would do, rather than after
    				const notes = [];
    				if (status.replacesToday) {
    					const at = new Date(status.replacesToday).toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' });
    					notes.push(`There are already ${status.perDay} backups today, so backing up now replaces the one from ${at}.`);
    				}
    				if (status.postponesNext) {
    					notes.push('Backing up now counts as tonight\'s backup, so the 04:00 one will be skipped until tomorrow.');
    				}
    				const note = document.getElementById('backup-note');
    				note.hidden = notes.length === 0 || Boolean(running) || Boolean(status.viewOnly);
    				note.innerText = notes.join(' ');

    				const button = document.getElementById('backup-run');
    				if (!button.classList.contains('loading')) button.disabled = Boolean(running);

    				document.getElementById('backup-keep').innerText = `newest ${status.keep}`;
    				if (status.driveLabel) document.getElementById('backup-drive').innerText = status.driveLabel;
    				document.getElementById('backup-list').innerHTML = status.backups.length
    					? status.backups
    							.map(
    								(backup) => `
    									<div class="backup-row ${backup.valid ? '' : 'invalid'}">
    										<span class="backup-when">${escapeHtml(formatWhen(backup.startedAt))}</span>
    										<span class="chip">${escapeHtml(backup.trigger)}</span>
    										<span class="backup-size">${formatBytes(backup.zipBytes)} · ${(backup.fileCount ?? 0).toLocaleString()} files</span>
    										<span class="badge ${backup.valid ? 'healthy' : 'critical'}">${backup.valid ? 'Verified' : 'Damaged'}</span>
    									</div>
    								`
    							)
    							.join('')
    					: '<div class="empty">No backups yet.</div>';

    				const sources = status.latestSources ?? [];
    				const system = status.latestSystem ?? [];
    				document.getElementById('backup-source-count').innerText = `${sources.length} locations${system.length ? ` + ${system.length} system` : ''}${status.sourcesArePlanned ? ', planned' : ''}`;
    				// System files first, since they are what makes restore.sh work
    				const systemRows = system
    					.map(
    						(item) => `
    							<div class="source-row">
    								<span class="source-path">${escapeHtml(item.label)}</span>
    								<span class="source-kind">system</span>
    								<span class="source-size">${escapeHtml(item.path)}</span>
    							</div>
    						`
    					)
    					.join('');
    				document.getElementById('backup-sources').innerHTML = systemRows + sources
    					.map(
    						(source) => `
    							<div class="source-row">
    								<span class="source-path">${escapeHtml(source.path)}</span>
    								<span class="source-kind">${escapeHtml(source.kind)}</span>
    								<span class="source-size">${source.files.toLocaleString()} · ${formatBytes(source.bytes)}</span>
    							</div>
    						`
    					)
    					.join('');

    				clearTimeout(backupPoll);
    				backupPoll = setTimeout(loadBackups, running ? 4000 : 60000);
    			}

    			async function loadBackups() {
    				try {
    					const response = await fetch('/server/backups', { credentials: 'same-origin' });
    					if (!response.ok) throw new Error(`HTTP ${response.status}`);
    					renderBackups(await response.json());
    				} catch (error) {
    					console.log(error);
    					clearTimeout(backupPoll);
    					backupPoll = setTimeout(loadBackups, 60000);
    				}
    			}

    			document.getElementById('backup-run').addEventListener('click', async (event) => {
    				await runAction(event.currentTarget, { url: '/server/backups/run' }, 'Started');
    				loadBackups();
    			});

    			function setBackupOpen(open) {
    				const body = document.getElementById('backup-body');
    				const toggle = document.getElementById('backup-toggle');
    				body.classList.toggle('open', open);
    				body.inert = !open;
    				toggle.classList.toggle('open', open);
    				toggle.setAttribute('aria-expanded', String(open));
    			}

    			document.getElementById('backup-toggle').addEventListener('click', () => {
    				setBackupOpen(!document.getElementById('backup-body').classList.contains('open'));
    			});

    			loadBackups();

    			function render(data) {
    				document.getElementById('hostname').innerText = data.host.hostname;
    				// Shared views get the platform only, the server leaves the rest out
    				document.getElementById('host-detail').innerText = data.redacted
    					? `${data.host.platform} · ${data.cpu.count} threads`
    					: `${data.host.platform} · ${data.cpu.model} · ${data.network.interface ?? 'no uplink'} ${data.network.address ?? ''}`;

    				renderStats(data);
    				renderDrives(data);
    				renderPower(data);
    				renderEvents(data);
    				renderServices(data);
    				if (!peerArmed) renderVpn(data.vpn);
    				renderAlerts(data.alerts);
    			}

    			function setLive(ok, text) {
    				const live = document.getElementById('live');
    				live.classList.toggle('stale', !ok);
    				document.getElementById('live-text').innerText = text;
    			}

    			async function refresh() {
    				try {
    					const response = await fetch('/server/stats', {
    						credentials: 'same-origin',
    					});

    					if (response.status === 401) {
    						window.location.href = '/error/401';
    						return;
    					}

    					if (!response.ok) {
    						setLive(false, 'Error');
    						return;
    					}

    					const data = await response.json();
    					render(data);
    					setLive(true, `Updated ${new Date().toLocaleTimeString('en-GB')}`);
    				} catch (error) {
    					console.log(error);
    					setLive(false, 'Disconnected');
    				}
    			}

    			// Owner only. Generates a view-only code, shows it and copies the link
    			const shareDialog = document.getElementById('share-dialog');
    			if (shareDialog) {
    				const status = document.getElementById('share-status');

    				const showCode = async (code) => {
    					document.getElementById('share-pin').innerText = code.pin;
    					document.getElementById('share-url').innerText = code.url;
    					const until = new Date(code.expiresAt).toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' });
    					try {
    						await navigator.clipboard.writeText(code.url);
    						status.innerText = `Link copied · expires at ${until}`;
    					} catch {
    						status.innerText = `Expires at ${until}`;
    					}
    				};

    				const newCode = async () => {
    					status.innerText = 'Generating...';
    					try {
    						const response = await fetch('/server/share', { method: 'POST', credentials: 'same-origin' });
    						const data = await response.json();
    						if (!response.ok) throw new Error(data?.error ?? `HTTP ${response.status}`);
    						await showCode(data);
    					} catch (error) {
    						status.innerText = error.message;
    					}
    				};

    				document.getElementById('share-button').addEventListener('click', () => {
    					shareDialog.showModal();
    					newCode();
    				});
    				document.getElementById('share-new').addEventListener('click', newCode);
    				document.getElementById('share-copy').addEventListener('click', async () => {
    					try {
    						await navigator.clipboard.writeText(document.getElementById('share-url').innerText);
    						status.innerText = 'Link copied';
    					} catch {
    						status.innerText = 'Copy failed, select the link instead';
    					}
    				});
    				document.getElementById('share-stop').addEventListener('click', async () => {
    					const response = await fetch('/server/share', { method: 'DELETE', credentials: 'same-origin' });
    					document.getElementById('share-pin').innerText = '----';
    					document.getElementById('share-url').innerText = '';
    					status.innerText = response.ok ? 'Every share code and link has stopped working' : 'Could not stop sharing';
    				});
    				document.getElementById('share-close').addEventListener('click', () => shareDialog.close());
    				shareDialog.addEventListener('click', (event) => {
    					if (event.target === shareDialog) shareDialog.close();
    				});
    			}

    			// Owner only. Pills open a confirmation, nothing restarts on one click
    			const restartDialog = document.getElementById('restart-dialog');
    			if (restartDialog) {
    				let target = null;
    				const status = document.getElementById('restart-status');
    				const confirm = document.getElementById('restart-confirm');

    				const formatSince = (value) => {
    					if (!value) return 'unknown';
    					const minutes = Math.round((Date.now() - new Date(value).getTime()) / 60000);
    					if (minutes < 60) return `${minutes} min`;
    					if (minutes < 2880) return `${Math.round(minutes / 60)} h`;
    					return `${Math.round(minutes / 1440)} days`;
    				};

    				const open = (kind, name) => {
    					const list = kind === 'service' ? lastStats?.services ?? [] : lastStats?.containers ?? [];
    					const item = list.find((entry) => entry.name === name);
    					if (!item) return;
    					target = { kind, name };

    					document.getElementById('restart-kind').innerText = kind === 'service' ? 'pm2 service' : 'Docker container';
    					document.getElementById('restart-title').innerText = `Restart ${name}?`;

    					const facts = kind === 'service'
    						? [['Status', item.status], ['Up for', item.status === 'online' ? formatSince(item.uptime) : 'not running'], ['Restarts so far', item.restarts]]
    						: [['State', item.state], ['Docker says', item.status], ...(item.sharesNetworkWith ? [['Uses the network of', item.sharesNetworkWith]] : [])];
    					document.getElementById('restart-facts').innerHTML = facts
    						.map(([key, value]) => `<div class="row"><span class="key">${escapeHtml(key)}</span><span class="val">${escapeHtml(value)}</span></div>`)
    						.join('');

    					// Containers routed through this one lose their network with it,
    					// so they restart too, and the dialog says so up front
    					const dependents = kind === 'container'
    						? (lastStats?.containers ?? []).filter((entry) => entry.sharesNetworkWith === name).map((entry) => entry.name)
    						: [];
    					const note = document.getElementById('restart-note');
    					const notes = [];
    					if (dependents.length) notes.push(`${dependents.join(' and ')} ${dependents.length === 1 ? 'uses' : 'use'} its network and will restart too.`);
    					if (kind === 'service' && name === window.SERVER_APP_NAME) notes.push('This is the website you are using. The page will lose its connection for a few seconds and then carry on.');
    					if (kind === 'service' && name === 'auth') notes.push('Logins are checked by this service, so pages may refuse requests for a moment.');
    					note.hidden = notes.length === 0;
    					note.innerText = notes.join(' ');

    					status.innerText = '';
    					status.classList.remove('is-error');
    					confirm.disabled = false;
    					confirm.innerText = 'Restart';
    					restartDialog.showModal();
    					confirm.focus({ preventScroll: true });
    				};

    				const pillClick = (event) => {
    					const pill = event.target.closest('.pill--action');
    					if (!pill || pill.disabled) return;
    					open(pill.dataset.kind, pill.dataset.name);
    				};
    				document.getElementById('services').addEventListener('click', pillClick);
    				document.getElementById('containers').addEventListener('click', pillClick);

    				document.getElementById('restart-cancel').addEventListener('click', () => restartDialog.close());
    				restartDialog.addEventListener('click', (event) => {
    					if (event.target === restartDialog) restartDialog.close();
    				});

    				confirm.addEventListener('click', async () => {
    					if (!target) return;
    					confirm.disabled = true;
    					confirm.innerText = 'Restarting...';
    					status.classList.remove('is-error');
    					status.innerText = target.kind === 'container' ? 'Docker can take up to a minute' : '';
    					try {
    						const path = target.kind === 'service' ? 'services' : 'containers';
    						const response = await fetch(`/server/${path}/${encodeURIComponent(target.name)}/restart`, {
    							method: 'POST',
    							credentials: 'same-origin',
    						});
    						const data = await response.json();
    						if (!response.ok) throw new Error(data?.error ?? `HTTP ${response.status}`);
    						status.innerText = data.self ? 'Restarting the website...' : `Restarted ${data.restarted.join(', ')}`;
    						confirm.innerText = 'Done';
    						setTimeout(() => restartDialog.close(), data.self ? 4000 : 1400);
    						setTimeout(refresh, data.self ? 6000 : 1500);
    					} catch (error) {
    						status.classList.add('is-error');
    						status.innerText = error.message;
    						confirm.disabled = false;
    						confirm.innerText = 'Try again';
    					}
    				});
    			}

    			// View only. The server refuses every change from a viewer anyway,
    			// this keeps the controls from looking usable. Anything re-rendered
    			// later, like the VPN cards, is caught by the observer
    			if (window.SERVER_VIEW_ONLY) {
    				const ACTIONS = [
    					'#run-check',
    					'#send-notification',
    					'#rules-save',
    					'#rules-reset',
    					'#rules input',
    					'#vpn-restart',
    					'#vpn-new input',
    					'#vpn-new button',
    					'.peer-remove',
    					'.peer-qr',
    					'#backup-run',
    					'.pill--action',
    				].join(', ');

    				const lock = () => {
    					for (const control of document.querySelectorAll(ACTIONS)) {
    						if (!control.disabled) {
    							control.disabled = true;
    							control.title = 'View only';
    						}
    					}
    				};

    				lock();
    				new MutationObserver(lock).observe(document.querySelector('main'), {
    					childList: true,
    					subtree: true,
    					attributes: true,
    					attributeFilter: ['disabled'],
    				});

    				document.querySelector('#rules-toggle .edit').innerText = 'View rules';
    				document.getElementById('backup-toggle').hidden = true;
    				document.getElementById('vpn-new-status').innerText = 'View only';

    				const banner = document.getElementById('view-banner');
    				if (banner && window.SERVER_VIEW_EXPIRES) {
    					const until = new Date(window.SERVER_VIEW_EXPIRES).toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' });
    					banner.innerText = `View only · until ${until}`;
    				}
    			}

    			loadRules();
    			refresh();
    			setInterval(refresh, REFRESH_MS);
    		})();
    	</script>
    </body>
</html>
