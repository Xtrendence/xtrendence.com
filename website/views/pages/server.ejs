								document.getElementById('drill-run').addEventListener('click', async (event) => {
									await runAction(event.currentTarget, { url: '/server/drill/run' }, 'Started');
									await loadBackups();
									if (drillStatus?.running) openDrillDialog();
								});

								document.getElementById('mirror-run').addEventListener('click', async (event) => {
									await runAction(event.currentTarget, { url: '/server/vault-mirror/run' }, 'Started');
									await loadBackups();
								});

								const mirrorCancel = document.getElementById('mirror-cancel');
								if (mirrorCancel) {
									mirrorCancel.addEventListener('click', async () => {
										mirrorCancel.disabled = true;
										await mirrorRequest('/server/vault-mirror/cancel').catch(() => {});
										mirrorCancel.disabled = false;
									});
								}

								// Two clicks, the second names exactly how many files go
								const mirrorApprove = document.getElementById('mirror-approve');
								if (mirrorApprove) {
									let armed = null;
									mirrorApprove.addEventListener('click', async () => {
										const deletes = mirrorStatus?.held?.deletes;
										if (!deletes) return;
										if (!armed) {
											mirrorApprove.classList.add('is-armed');
											mirrorApprove.innerText = `Delete ${deletes.toLocaleString()} from the backup`;
											armed = setTimeout(() => {
												armed = null;
												mirrorApprove.classList.remove('is-armed');
												mirrorApprove.innerText = 'Review deletes';
											}, 6000);
											return;
										}
										clearTimeout(armed);
										armed = null;
										mirrorApprove.disabled = true;
										try {
											await mirrorRequest('/server/vault-mirror/run', { approve: deletes });
