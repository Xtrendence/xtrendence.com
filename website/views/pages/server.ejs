										if (dependents.length) notes.push(`${dependents.join(' and ')} ${dependents.length === 1 ? 'uses' : 'use'} its network and will restart too.`);
										if (kind === 'service' && name === window.SERVER_APP_NAME) notes.push('This is the website you are using. The page will lose its connection for a few seconds and then carry on.');
										if (kind === 'service' && name === 'auth') notes.push('Logins are checked by this service, so pages may refuse requests for a moment.');
										note.hidden = notes.length === 0;
										note.innerText = notes.join(' ');

										status.innerText = '';
										status.classList.remove('is-error');
