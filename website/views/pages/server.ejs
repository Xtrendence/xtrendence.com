									const status = document.getElementById('qr-status');
									const submit = document.getElementById('qr-submit');
									if (!qrProfile || !input.value) return;

									submit.disabled = true;
									status.classList.remove('is-error');
									status.innerText = 'Checking...';

									try {
										const response = await fetch(`/server/vpn/profiles/${encodeURIComponent(qrProfile)}/${qrMode}`, {
											method: 'POST',
											credentials: 'same-origin',
											headers: { 'Content-Type': 'application/json' },
											body: JSON.stringify({ password: input.value }),
										});
										const data = await response.json();
										if (!response.ok) throw new Error(data?.error ?? `HTTP ${response.status}`);

										input.value = '';
										// Handed straight to the browser as a file, the object URL goes as soon as the download starts
										if (qrMode === 'conf') {
											const url = URL.createObjectURL(new Blob([data.config], { type: 'application/octet-stream' }));
											const link = document.createElement('a');
											link.href = url;
											link.download = `${data.name ?? qrName}.conf`;
											document.body.append(link);
											link.click();
											link.remove();
											setTimeout(() => URL.revokeObjectURL(url), 1000);
											submit.disabled = false;
											closeQr();
											return;
										}
										// As an image rather than inline markup, so nothing in the SVG can run
										document.getElementById('qr-image').src =
											`data:image/svg+xml;base64,${btoa(unescape(encodeURIComponent(data.svg)))}`;
