										try {
											const path = target.kind === 'service' ? 'services' : 'containers';
											const response = await fetch(`/server/${path}/${encodeURIComponent(target.name)}/restart`, {
												method: 'POST',
												credentials: 'same-origin',
											});
											const data = await response.json();
											if (!response.ok) throw new Error(data?.error ?? `HTTP ${response.status}`);
											status.innerText = data.self ? 'Restarting the website...' : `Restarted ${data.restarted.join(', ')}`;
											confirm.innerText = 'Done';
											setTimeout(() => restartDialog.close(), data.self ? 4000 : 1400);
											setTimeout(refresh, data.self ? 6000 : 1500);
										} catch (error) {
											status.classList.add('is-error');
											status.innerText = error.message;
											confirm.disabled = false;
											confirm.innerText = 'Try again';
										}
									});
								}

								// View only. The server refuses changes anyway, this just disables controls
								if (window.SERVER_VIEW_ONLY) {
									const ACTIONS = [
										'#run-check',
										'#send-notification',
										'#rules-save',
										'#rules-reset',
										'#rules input',
										'#vpn-restart',
										'#vpn-new input',
										'#vpn-new button',
										'.peer-remove',
										'.peer-qr',
										'.peer-download',
										'#backup-run',
										'#drill-run',
										'#backup-drive',
										'#tunnel-restart',
										'#recovery input',
										'#recovery select',
										'#recovery-save',
										'#recovery-reset',
										'.pill--action',
									].join(', ');

									const lock = () => {
										for (const control of document.querySelectorAll(ACTIONS)) {
											if (!control.disabled) {
												control.disabled = true;
												control.title = 'View only';
											}
										}
									};

									lock();
									new MutationObserver(lock).observe(document.querySelector('main'), {
										childList: true,
										subtree: true,
										attributes: true,
										attributeFilter: ['disabled'],
									});

									document.querySelector('#rules-toggle .edit').innerText = 'View rules';
									document.getElementById('backup-toggle').hidden = true;
									document.getElementById('vpn-new-status').innerText = 'View only';

									const banner = document.getElementById('view-banner');
									if (banner && window.SERVER_VIEW_EXPIRES) {
										const until = new Date(window.SERVER_VIEW_EXPIRES).toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' });
										banner.innerText = `View only · until ${until}`;
									}
								}

								// Time machine, drawn with the live render while polling pauses
								(() => {
									const card = document.getElementById('time-machine');
									const slider = document.getElementById('tm-slider');
									const canvas = document.getElementById('tm-canvas');
									const playhead = document.getElementById('tm-playhead');
									const stamp = document.getElementById('tm-stamp');
									const meta = document.getElementById('tm-meta');
									const axis = document.getElementById('tm-axis');
									const playButton = document.getElementById('tm-play');

									const LEVEL_VARS = { ok: '--health-ok', soft: '--health-soft', hard: '--health-hard' };

									let range = '24h';
									try {
										range = localStorage.getItem('server-tm-range') || range;
									} catch { }
									let timeline = null;
									let request = 0;
									let debounce = null;
									let playing = null;

									const clock = (time, withDay) =>
										new Date(time).toLocaleString('en-GB', {
											...(withDay ? { weekday: 'short', day: 'numeric', month: 'short' } : {}),
											hour: '2-digit',
											minute: '2-digit',
										});

									const ago = (time) => {
										const minutes = Math.round((Date.now() - time) / 60000);
										if (minutes < 60) return `${minutes} min ago`;
										if (minutes < 2880) return `${Math.round(minutes / 60)} h ago`;
										return `${Math.round(minutes / 1440)} days ago`;
									};

									// Each snapshot fills until the next, worse levels drawn on top
									function draw() {
										if (!timeline) return;
										const ratio = window.devicePixelRatio || 1;
										const width = canvas.clientWidth;
										const height = canvas.clientHeight;
										if (!width || !height) return;
										canvas.width = Math.round(width * ratio);
										canvas.height = Math.round(height * ratio);
										const context = canvas.getContext('2d');
										context.scale(ratio, ratio);
										context.clearRect(0, 0, width, height);

										const styles = getComputedStyle(card);
										const span = timeline.now - timeline.since;
										const x = (time) => ((time - timeline.since) / span) * width;
										const points = timeline.points;

										for (const level of [null, 'ok', 'soft', 'hard']) {
											context.fillStyle = styles.getPropertyValue(LEVEL_VARS[level] ?? '--ink-3').trim();
											context.globalAlpha = level === 'ok' ? 0.42 : level ? 0.95 : 0.25;
											const barHeight = level === 'hard' ? height - 6 : level === 'soft' ? height - 12 : height - 18;
											for (let index = 0; index < points.length; index++) {
												const [time, pointLevel] = points[index];
												if ((pointLevel ?? null) !== level) continue;
												const next = points[index + 1]?.[0] ?? timeline.now;
												const until = Math.min(next, time + 65 * 60000);
												const from = x(time);
												context.fillRect(from, height - 4 - barHeight, Math.max(1, x(until) - from), barHeight);
											}
										}

										context.globalAlpha = 1;
										context.fillStyle = styles.getPropertyValue('--health-hard').trim();
										for (const [started, ended] of timeline.outages) {
											const from = Math.max(0, x(started));
											const to = Math.min(width, x(ended ?? timeline.now));
											context.fillRect(from, height - 3, Math.max(2, to - from), 3);
										}
									}

									function drawAxis() {
										const track = document.getElementById('tm-track');
										const contentLeft = card.getBoundingClientRect().left + card.clientLeft + parseFloat(getComputedStyle(card).paddingLeft);
										axis.style.marginLeft = `${track.getBoundingClientRect().left - contentLeft}px`;
										axis.style.width = `${track.clientWidth}px`;
										const span = timeline.now - timeline.since;
										const marks = 5;
										axis.innerHTML = Array.from({ length: marks }, (_, index) => {
											const time = timeline.since + (span * index) / (marks - 1);
											const label = index === marks - 1 ? 'Now' : clock(time, span > 86400000);
											return `<span style="left:${(index / (marks - 1)) * 100}%">${escapeHtml(label)}</span>`;
										}).join('');
									}

									function placePlayhead(time) {
										const span = timeline.now - timeline.since;
										const share = Math.min(1, Math.max(0, (time - timeline.since) / span));
										playhead.style.left = `${share * 100}%`;
										playhead.classList.toggle('flip', share > 0.75);
									}

									function syncTabs() {
										for (const tab of document.querySelectorAll('#tm-ranges button')) {
											tab.setAttribute('aria-selected', String(tab.dataset.range === range));
										}
									}

									async function loadTimeline() {
										try {
											const response = await fetch(`/server/timeline?range=${range}`, { credentials: 'same-origin' });
											if (!response.ok) throw new Error(`${response.status}`);
											timeline = await response.json();
										} catch {
											meta.innerText = 'Unavailable';
											return;
										}

										slider.min = String(timeline.since);
										slider.max = String(timeline.now);
										if (pastAt === null) slider.value = slider.max;
										meta.innerText = timeline.points.length
											? `${timeline.points.length} snapshots · since ${clock(timeline.first, true)}`
											: 'Recording, the first snapshot lands within a minute';
										draw();
										drawAxis();
										placePlayhead(pastAt ?? timeline.now);
									}

									function goLive() {
										stop();
										pastAt = null;
										request++;
										document.body.classList.remove('is-past');
										stamp.innerText = 'Now';
										if (timeline) {
											slider.value = slider.max;
											placePlayhead(timeline.now);
										}
										setLive(true, 'Live');
										refresh();
									}

									async function show(time) {
										const id = ++request;
										try {
											const response = await fetch(`/server/snapshot?t=${Math.round(time)}`, { credentials: 'same-origin' });
											if (id !== request) return;
											if (!response.ok) {
												stamp.innerText = response.status === 404 ? 'Nothing recorded yet' : 'Could not load';
												return;
											}
											const snapshot = await response.json();
											if (id !== request) return;

											pastAt = snapshot.t;
											document.body.classList.add('is-past');
											render(snapshot.stats);
											stamp.innerText = clock(snapshot.t, true);
											const live = document.getElementById('live');
											live.classList.add('stale');
											document.getElementById('live-text').innerText = ago(snapshot.t);
											placePlayhead(snapshot.t);
										} catch {
											if (id === request) stamp.innerText = 'Could not load';
										}
									}

									// Near the right edge counts as live
									function scrubTo(time) {
										if (!timeline) return;
										if (timeline.now - time < 90000) {
											goLive();
											return;
										}
										stamp.innerText = clock(time, true);
										placePlayhead(time);
										clearTimeout(debounce);
										debounce = setTimeout(() => show(time), 140);
									}

									function neighbour(direction) {
										if (!timeline?.points.length) return null;
										const from = pastAt ?? timeline.now;
										const points = timeline.points;
										if (direction < 0) {
											for (let index = points.length - 1; index >= 0; index--) {
												if (points[index][0] < from) return points[index][0];
											}
											return null;
										}
										return points.find(([time]) => time > from)?.[0] ?? null;
									}

									function step(direction) {
										const time = neighbour(direction);
										if (time === null) {
											if (direction > 0) goLive();
											return;
										}
										slider.value = String(time);
										stamp.innerText = clock(time, true);
										placePlayhead(time);
										show(time);
									}

									function stop() {
										clearInterval(playing);
										playing = null;
										playButton.classList.remove('playing');
										playButton.setAttribute('aria-label', 'Play');
									}

									// About four snapshots a second, back to live at the end
									function play() {
										if (playing) {
											stop();
											return;
										}
										if (pastAt === null) {
											const first = timeline?.points[0]?.[0];
											if (!first) return;
											slider.value = String(first);
											show(first);
										}
										playButton.classList.add('playing');
										playButton.setAttribute('aria-label', 'Pause');
										playing = setInterval(() => step(1), 260);
									}

									slider.addEventListener('input', () => {
										stop();
										scrubTo(Number(slider.value));
									});
									document.getElementById('tm-prev').addEventListener('click', () => {
										stop();
										step(-1);
									});
									document.getElementById('tm-next').addEventListener('click', () => {
										stop();
										step(1);
									});
									playButton.addEventListener('click', play);
									document.getElementById('tm-live').addEventListener('click', goLive);
									document.getElementById('tm-ranges').addEventListener('click', (event) => {
										const tab = event.target.closest('button[data-range]');
										if (!tab || tab.dataset.range === range) return;
										range = tab.dataset.range;
										try {
											localStorage.setItem('server-tm-range', range);
										} catch { }
										syncTabs();
										loadTimeline();
									});

									// The past is read only, so action clicks are stopped before their handlers
									document.querySelector('main').addEventListener(
										'click',
										(event) => {
											if (pastAt === null) return;
											const control = event.target.closest('button, a, input, select, summary, [role="button"]');
											if (!control || control.closest('#time-machine, #range-tabs, .rules-toggle')) return;
											event.preventDefault();
											event.stopImmediatePropagation();
										},
										true
									);

									document.addEventListener('keydown', (event) => {
										if (event.key === 'Escape' && pastAt !== null && !document.querySelector('dialog[open]')) goLive();
									});

									let resizeFrame = null;
									window.addEventListener('resize', () => {
										cancelAnimationFrame(resizeFrame);
										resizeFrame = requestAnimationFrame(() => {
											draw();
											if (timeline) drawAxis();
										});
									});

									syncTabs();
									loadTimeline();
									// Only refreshed live, so the playhead does not drift while scrubbing
									setInterval(() => {
										if (pastAt === null && !playing) loadTimeline();
									}, 60000);

								})();

								// Internet recovery. Plugs come from the lights tool, edits are kept until saved
								const recovery = (() => {
									const $ = (id) => document.getElementById(id);
									const fields = {
										gatewayHost: $('recovery-gateway'),
										modemPlugId: $('recovery-modem-plug'),
										routerPlugId: $('recovery-router-plug'),
										modemEnabled: $('recovery-modem-on'),
										routerEnabled: $('recovery-router-on'),
										downMinutes: $('recovery-down'),
										gapMinutes: $('recovery-gap'),
									};
									let saved = null;
									let latest = null;
									let dirty = false;

									const read = () => ({
										gatewayHost: fields.gatewayHost.value.trim(),
										modemPlugId: fields.modemPlugId.value === '' ? null : Number(fields.modemPlugId.value),
										routerPlugId: fields.routerPlugId.value === '' ? null : Number(fields.routerPlugId.value),
										modemEnabled: fields.modemEnabled.checked,
										routerEnabled: fields.routerEnabled.checked,
										downMinutes: Number(fields.downMinutes.value),
										gapMinutes: Number(fields.gapMinutes.value),
									});

									const options = (plugs, selected) =>
										['<option value="">None</option>']
											.concat(
												plugs.map(
													(plug) =>
														`<option value="${plug.id}" ${plug.id === selected ? 'selected' : ''}>${escapeHtml(plug.name)}${plug.online === false ? ' (offline)' : ''}</option>`
												)
											)
											.join('');

									function fill(settings, plugs) {
										fields.gatewayHost.value = settings.gatewayHost ?? '';
										fields.modemPlugId.innerHTML = options(plugs, settings.modemPlugId);
										fields.routerPlugId.innerHTML = options(plugs, settings.routerPlugId);
										fields.modemEnabled.checked = settings.modemEnabled;
										fields.routerEnabled.checked = settings.routerEnabled;
										fields.downMinutes.value = settings.downMinutes;
										fields.gapMinutes.value = settings.gapMinutes;
									}

									const clock = (time) => new Date(time).toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' });
									const inMinutes = (time) => {
										const minutes = Math.ceil((time - Date.now()) / 60000);
										return minutes <= 1 ? 'in under a minute' : `in ${minutes} min`;
									};

									function stepStatus(step, settings, status) {
										const on = settings[`${step}Enabled`] && settings[`${step}PlugId`] !== null;
										const record = status[step];
										if (!on) return { tone: 'off', text: settings[`${step}PlugId`] === null ? 'No plug picked' : 'Off' };
										if (status.running === step) return { tone: 'busy', text: `Restarting since ${clock(record.startedAt)}` };
										if (record?.ok) return { tone: 'ok', text: `Restarted at ${clock(record.startedAt)}` };
										if (record && record.ok === false) return { tone: 'bad', text: `Failed: ${record.error}` };
										if (status.next?.step === step) {
											return { tone: 'busy', text: status.next.at ? `Restarts ${inMinutes(status.next.at)}` : 'Waits for the modem' };
										}
										return { tone: 'ready', text: status.outage ? 'Waiting' : 'Ready' };
									}

									function renderRecovery() {
										if (!latest) return;
										const settings = dirty ? read() : latest.settings;
										const status = latest.status;
										const modemOn = settings.modemEnabled && settings.modemPlugId !== null;
										const routerOn = settings.routerEnabled && settings.routerPlugId !== null;

										for (const step of ['modem', 'router']) {
											const line = stepStatus(step, settings, status);
											const element = $(`recovery-${step}-status`);
											element.className = `flow-status tone-${line.tone}`;
											element.innerText = line.text;
											$(`recovery-${step}`).classList.toggle('is-on', step === 'modem' ? modemOn : routerOn);
											$(`recovery-${step}`).classList.toggle('is-active', status.running === step || status.next?.step === step);
										}
										$('recovery-gap-wait').classList.toggle('is-off', !(modemOn && routerOn));
										$('recovery-flow').classList.toggle('is-outage', Boolean(status.outage));

										const steps = [modemOn ? 'the modem' : null, routerOn ? 'the router' : null].filter(Boolean);
										$('recovery-meta').innerText = latest.plugsError
											? latest.plugsError
											: status.gateway?.up === false
												? `The router at ${status.gateway.host} is not answering, so this is a router problem and nothing restarts`
												: status.outage
													? `Internet down since ${clock(status.outage.started)}`
													: steps.length
														? `Restarts ${steps.join(', then ')} if the internet is down for ${settings.downMinutes} min`
														: 'Off. Pick a plug and turn a reboot on';

										const note = [];
										if (modemOn && routerOn) note.push(`The router waits ${settings.gapMinutes} min after the modem is back on, and only restarts if the internet is still down.`);
										if (steps.length) note.push('Each runs once per outage, and stops as soon as the internet is back.');
										note.push('Only an outage with the router answering counts. A router that is off or rebooting is logged as a router event and never triggers this.');
										$('recovery-note').innerText = note.join(' ');
									}

									function setDirty(value) {
										dirty = value;
										$('recovery-save').disabled = !value || window.SERVER_VIEW_ONLY;
										$('recovery-reset').disabled = !value || window.SERVER_VIEW_ONLY;
									}

									async function load() {
										try {
											const response = await fetch('/server/recovery', { credentials: 'same-origin' });
											if (!response.ok) throw new Error(`HTTP ${response.status}`);
											latest = await response.json();
											if (!dirty) {
												saved = latest.settings;
												fill(latest.settings, latest.plugs);
											}
											renderRecovery();
										} catch (error) {
											$('recovery-meta').innerText = `Could not load: ${error.message}`;
										}
									}

									$('recovery').addEventListener('input', () => {
										setDirty(true);
										renderRecovery();
									});
									$('recovery').addEventListener('change', () => {
										setDirty(true);
										renderRecovery();
									});
									$('recovery-reset').addEventListener('click', () => {
										setDirty(false);
										if (latest) fill(saved, latest.plugs);
										renderRecovery();
									});
									$('recovery-save').addEventListener('click', async () => {
										const button = $('recovery-save');
										button.disabled = true;
										try {
											const response = await fetch('/server/recovery', {
												method: 'PUT',
												credentials: 'same-origin',
												headers: { 'Content-Type': 'application/json' },
												body: JSON.stringify(read()),
											});
											const data = await response.json().catch(() => ({}));
											if (!response.ok) throw new Error(data?.error ?? `HTTP ${response.status}`);
											saved = data.settings;
											latest = { ...latest, settings: data.settings, status: data.status };
											setDirty(false);
											renderRecovery();
											$('recovery-note').innerText = 'Saved.';
										} catch (error) {
											button.disabled = false;
											$('recovery-note').innerText = error.message;
										}
									});

									load();
									setInterval(load, 15000);
								})();

								// What the watchdogs have done lately, the panel only shows when there is something to say
								async function loadHealing() {
									try {
										const response = await fetch('/server/healing', { credentials: 'same-origin' });
										if (!response.ok) return;
										const data = await response.json();
										const box = document.getElementById('healing');
										box.hidden = !data.log.length;
										document.getElementById('healing-list').innerHTML = data.log
											.slice(0, 6)
											.map(
												(entry) => `
    								<div class="healing-row">
    									<span class="healing-when">${escapeHtml(formatWhen(new Date(entry.at).toISOString()))}</span>
    									<span class="healing-service">${escapeHtml(entry.service)}</span>
    									<span class="healing-message">${escapeHtml(entry.message)}</span>
    								</div>
    							`
											)
											.join('');
									} catch { }
								}
								loadHealing();
								setInterval(loadHealing, 60000);

								// Two taps, since the public site drops for a few seconds while it restarts
								const tunnelButton = document.getElementById('tunnel-restart');
								if (tunnelButton) {
									let armedAt = 0;
									const label = tunnelButton.querySelector('.action-label');
									tunnelButton.addEventListener('click', async () => {
										if (Date.now() - armedAt > 4000) {
											armedAt = Date.now();
											label.innerText = 'Tap to confirm';
											tunnelButton.classList.add('armed');
											setTimeout(() => {
												if (Date.now() - armedAt >= 4000) {
													label.innerText = 'Restart tunnel';
													tunnelButton.classList.remove('armed');
												}
											}, 4000);
											return;
										}
										armedAt = 0;
										tunnelButton.classList.remove('armed');
										label.innerText = 'Restart tunnel';
										await runAction(tunnelButton, { url: '/server/cloudflared/restart' }, 'Restarting');
									});
								}

								// Owner only. Reboots the machine, then waits for it to come back with a new boot time
								const rebootDialog = document.getElementById('reboot-dialog');
								if (rebootDialog) {
									let bootedAt = null;
									let rebooting = false;
									let started = 0;
									let clockTimer = null;

									document.getElementById('reboot-button').addEventListener('click', async () => {
										if (rebooting) return;
										document.getElementById('reboot-status').innerText = '';
										try {
											const stats = await (await fetch('/server/stats', { credentials: 'same-origin' })).json();
											bootedAt = stats.uptime?.bootedAt ?? null;
											document.getElementById('reboot-facts').innerHTML = [
												['Host', stats.host?.hostname],
												['Up for', formatDuration(stats.uptime?.seconds ?? 0)],
												['Containers', `${(stats.containers ?? []).length}`],
											]
												.map(([key, value]) => `<div class="row"><span class="key">${key}</span><span class="val">${escapeHtml(value ?? '')}</span></div>`)
												.join('');
											document.getElementById('reboot-title').innerText = `Reboot ${stats.host?.hostname ?? 'the server'}?`;
										} catch { }
										rebootDialog.showModal();
										rebootDialog.focus();
									});

									document.getElementById('reboot-cancel').addEventListener('click', () => rebootDialog.close());
									rebootDialog.addEventListener('cancel', (event) => {
										if (rebooting) event.preventDefault();
									});

									const waitText = (text) => {
										document.getElementById('reboot-wait-text').innerText = text;
									};

									// Down first, then a stats answer with a different boot time means it is back
									async function waitForBoot() {
										let wentDown = false;
										while (rebooting) {
											await new Promise((resolve) => setTimeout(resolve, 3000));
											try {
												const response = await fetch('/server/stats', { credentials: 'same-origin', cache: 'no-store' });
												if (!response.ok) throw new Error();
												const stats = await response.json();
												if (stats.uptime?.bootedAt && stats.uptime.bootedAt !== bootedAt) {
													rebooting = false;
													clearInterval(clockTimer);
													waitText(`Back online after ${Math.round((Date.now() - started) / 1000)} s. Reloading...`);
													setTimeout(() => window.location.reload(), 1500);
													return;
												}
												waitText(wentDown ? 'Starting services...' : 'Shutting down...');
											} catch {
												wentDown = true;
												waitText('Offline, waiting for it to boot...');
											}
										}
									}

									document.getElementById('reboot-confirm').addEventListener('click', async (event) => {
										const button = event.currentTarget;
										button.disabled = true;
										try {
											const response = await fetch('/server/reboot', { method: 'POST', credentials: 'same-origin' });
											const data = await response.json().catch(() => ({}));
											if (!response.ok) throw new Error(data?.error ?? `HTTP ${response.status}`);
										} catch (error) {
											button.disabled = false;
											document.getElementById('reboot-status').innerText = error.message;
											return;
										}
										rebooting = true;
										started = Date.now();
										const title = document.getElementById('reboot-title');
										title.innerText = title.innerText.replace(/^Reboot (.+)\?$/, 'Rebooting $1');
										rebootDialog.classList.add('is-rebooting');
										document.getElementById('reboot-body').hidden = true;
										document.getElementById('reboot-wait').hidden = false;
										document.getElementById('reboot-cancel').hidden = true;
										button.hidden = true;
										const clock = document.getElementById('reboot-clock');
										clock.hidden = false;
										clockTimer = setInterval(() => {
											const seconds = Math.floor((Date.now() - started) / 1000);
											clock.innerText = `${String(Math.floor(seconds / 60)).padStart(2, '0')}:${String(seconds % 60).padStart(2, '0')}`;
										}, 1000);
										waitForBoot();
									});
								}

								loadRules();
								refresh();
								setInterval(refresh, REFRESH_MS);
							})();
						</script>
</body>

</html>