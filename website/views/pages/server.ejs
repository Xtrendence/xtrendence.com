										if (next.value !== confirm.value) return setStatus('The new passwords do not match', true);
										if (next.value === current.value) return setStatus('That is the current password', true);

										submit.disabled = true;
										setStatus('Changing...');
										try {
											const response = await fetch('/server/password', {
												method: 'POST',
												credentials: 'same-origin',
												headers: { 'Content-Type': 'application/json' },
												body: JSON.stringify({ current: current.value, next: next.value }),
