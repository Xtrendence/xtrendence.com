									<svg viewBox="0 0 24 24" aria-hidden="true">
										<path
											d="M12 4V1L8 5l4 4V6a6 6 0 0 1 5.7 7.9l1.5 1.5A8 8 0 0 0 12 4Zm0 14a6 6 0 0 1-5.7-7.9L4.8 8.6A8 8 0 0 0 12 20v3l4-4-4-4v3Z" />
									</svg>
									<span class="action-label">Sync now</span>
								</button>
