								function renderDriveOptions() {
									const current = drives.find((drive) => drive.current);
									const picked = drives.find((drive) => drive.mount === pickedDrive) ?? current;
									const busy = Boolean(backupStatus?.running || drillStatus?.running);

									document.getElementById('drive-options').innerHTML = drives.length
										? drives
											.map((drive) => {
												const used = drive.size ? ((drive.size - drive.avail) / drive.size) * 100 : 0;
												return `
    									<label class="drive-option${drive.mount === picked?.mount ? ' is-picked' : ''}${drive.usable ? '' : ' is-unusable'}">
    										<input type="radio" name="backup-drive" value="${escapeHtml(drive.mount)}" ${drive.mount === picked?.mount ? 'checked' : ''} ${drive.usable ? '' : 'disabled'} />
    										<span class="drive-head">
    											<span class="drive-name">${escapeHtml(drive.name)}</span>
    											${drive.current ? '<span class="drive-chip current">Current</span>' : ''}
    											${drive.backups ? `<span class="drive-chip">${drive.backups} backup${drive.backups === 1 ? '' : 's'} here</span>` : ''}
    										</span>
    										<span class="drive-bar"><span style="width:${used.toFixed(1)}%"></span></span>
    										<span class="drive-facts">${formatBytes(drive.avail)} free of ${formatBytes(drive.size)} · ${escapeHtml(drive.fstype)}${drive.label && drive.label !== drive.name ? ` · ${escapeHtml(drive.label)}` : ''}</span>
    										<span class="drive-path">${escapeHtml(drive.dir)}</span>
    									</label>
    								`;
											})
											.join('')
