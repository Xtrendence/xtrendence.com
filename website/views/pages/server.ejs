									const span = mirror.everyHours * 3600000;
									const next = new Date(mirror.nextScheduled).getTime();
									const ring = live ? (progress?.percent ?? 0) : Math.min(100, Math.max(0, (1 - (next - Date.now()) / span) * 100));
									document.getElementById('mirror-ring').style.strokeDasharray = `${ring} 100`;
									document.getElementById('mirror-ring-title').textContent = live
										? `${Math.round(ring)}% copied`
										: `The ring fills over the ${mirror.everyHours} hours between syncs, ${Math.round(ring)}% of the way to the next`;
									document.getElementById('mirror-progress').hidden = !live || !progress;
									document.getElementById('mirror-progress-fill').style.width = `${progress?.percent ?? 0}%`;

									const checks = document.getElementById('mirror-checks');
									const failed = !live && last && !last.ok && !mirror.held && last.error;
									checks.hidden = !failed;
									checks.innerHTML = failed
										? `<li class="drill-check bad"><span class="drill-check-label">${escapeHtml(last.error)}</span><span class="drill-check-detail">${escapeHtml(formatWhen(last.startedAt))}</span></li>`
