<style>
	/* The dock is the .com-only entry point to the internal tools. It borrows
       the glass primitive and tokens from the portfolio stylesheet so it reads
       as part of the same surface rather than a bolted-on panel. */

	.dock-trigger {
		position: fixed;
		top: 18px;
		right: 18px;
		z-index: 300;
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		padding: 0;
		border-radius: var(--r-pill);
		color: var(--ink-2);
		cursor: pointer;
		transition: color 0.3s var(--ease), background 0.4s var(--ease),
			border-color 0.4s var(--ease), transform 0.45s var(--ease-spring),
			box-shadow 0.4s var(--ease);
	}

	.dock-trigger svg {
		grid-area: 1 / 1;
		width: 19px;
		height: 19px;
		fill: currentColor;
		transition: transform 0.55s var(--ease-spring),
			opacity 0.35s var(--ease);
	}

	/* Same crossfade the theme toggle uses, so the two buttons behave alike. */
	.dock-trigger .glyph-close {
		transform: rotate(-70deg) scale(0.4);
		opacity: 0;
	}

	/* Once the scrim is up it sits inside this button's backdrop sample, which
       blows the blur out to a flat white disc. Open state paints its own
       background instead and drops the filter. */
	.dock-trigger.open {
		color: var(--ink);
		transform: rotate(90deg);
		background: var(--glass-bg-strong);
		border-color: var(--glass-border-hover);
		-webkit-backdrop-filter: none;
		backdrop-filter: none;
	}

	.dock-trigger.open .glyph-grid {
		transform: rotate(70deg) scale(0.4);
		opacity: 0;
	}

	.dock-trigger.open .glyph-close {
		transform: rotate(-90deg);
		opacity: 1;
	}

	#desktop .dock-trigger:hover {
		color: var(--ink);
		background: var(--glass-bg-hover);
		border-color: var(--glass-border-hover);
	}

	.dock-scrim {
		position: fixed;
		inset: 0;
		z-index: 290;
		opacity: 0;
		visibility: hidden;
		background: radial-gradient(120% 90% at 100% 0%,
				var(--scrim-near),
				var(--scrim-far));
		transition: opacity 0.45s var(--ease), visibility 0.45s;
	}

	/* Dark needs a shadow to pull focus, light needs a haze instead. */
	html,
	html.dark {
		--scrim-near: rgba(5, 7, 15, 0.55);
		--scrim-far: rgba(5, 7, 15, 0.18);
	}

	html.light {
		--scrim-near: rgba(228, 233, 244, 0.72);
		--scrim-far: rgba(228, 233, 244, 0.22);
	}

	.dock-scrim.open {
		opacity: 1;
		visibility: visible;
	}

	.dock {
		position: fixed;
		top: 72px;
		right: 18px;
		z-index: 310;
		width: 288px;
		max-height: calc(100vh - 92px);
		padding: 10px;
		overflow: hidden auto;
		display: flex;
		flex-direction: column;
		gap: 2px;
		border-radius: var(--r-lg);
		opacity: 0;
		visibility: hidden;
		transform: translateY(-12px) scale(0.95);
		transform-origin: 100% 0;
		transition: opacity 0.4s var(--ease), visibility 0.4s,
			transform 0.5s var(--ease-spring);
	}

	.dock.open {
		opacity: 1;
		visibility: visible;
		transform: none;
	}

	.dock-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 6px 10px 10px;
	}

	.dock-head .mini-title {
		margin: 0;
	}

	.dock-head-actions {
		display: flex;
		align-items: center;
		gap: 6px;
	}

	.dock-head .icon-btn {
		width: 28px;
		height: 28px;
		color: var(--ink-3);
	}

	.dock-head .icon-btn svg {
		width: 14px;
		height: 14px;
	}

	#desktop .dock-head .icon-btn:hover {
		color: var(--ink);
		background: var(--glass-bg-hover);
	}

	.dock-head kbd {
		font-family: var(--font-mono);
		font-size: 10px;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--ink-3);
		padding: 3px 7px;
		border-radius: 6px;
		border: 1px solid var(--hairline);
	}

	.dock-item {
		position: relative;
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 9px 10px;
		border-radius: var(--r-md);
		color: var(--ink);
		transition: background 0.3s var(--ease), transform 0.3s var(--ease);
	}

	/* Items arrive one after another, but only on the way in. */
	.dock.open .dock-item {
		animation: dock-in 0.5s var(--ease-spring) backwards;
		animation-delay: calc(var(--i) * 45ms + 60ms);
	}

	@keyframes dock-in {
		from {
			opacity: 0;
			transform: translateX(14px);
		}
	}

	/* No .glass here on purpose. A backdrop-filter inside the row's entrance
       animation gets flattened while it runs and snaps back the moment the
       compositing layer is released, which read as a flicker. This paints a
       plain translucent chip instead, and the light-up below is deliberate. */
	.dock-icon {
		display: grid;
		place-items: center;
		width: 36px;
		height: 36px;
		flex: none;
		border-radius: var(--r-sm);
		color: var(--ink-2);
		background: var(--glass-bg-strong);
		border: 1px solid var(--hairline);
		box-shadow: inset 0 1px 0 var(--glass-hi);
		transition: color 0.3s var(--ease), background 0.3s var(--ease),
			border-color 0.3s var(--ease), box-shadow 0.3s var(--ease);
	}

	/* Each chip ramps once from dim up to its resting brightness, a beat behind
       its own row, so the list lights up in sequence. One direction only, and
       monochrome: the accent is reserved for hover. */
	.dock.open .dock-icon {
		animation: dock-icon-glow 0.75s var(--ease) backwards;
		animation-delay: calc(var(--i) * 45ms + 140ms);
	}

	@keyframes dock-icon-glow {
		from {
			color: var(--ink-3);
			background: transparent;
			border-color: transparent;
			box-shadow: inset 0 1px 0 transparent;
		}
	}

	.dock-icon svg {
		width: 17px;
		height: 17px;
		fill: currentColor;
	}

	.dock-text {
		display: flex;
		flex-direction: column;
		gap: 1px;
		min-width: 0;
	}

	.dock-text b {
		font-size: 14.5px;
		font-weight: 550;
		letter-spacing: -0.01em;
	}

	.dock-text em {
		font-style: normal;
		font-size: 12px;
		color: var(--ink-3);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.dock-arrow {
		width: 15px;
		height: 15px;
		margin-left: auto;
		flex: none;
		fill: var(--ink-3);
		opacity: 0;
		transform: translateX(-6px);
		transition: opacity 0.3s var(--ease), transform 0.35s var(--ease-spring),
			fill 0.3s var(--ease);
	}

	#desktop .dock-item:hover {
		background: var(--glass-bg-hover);
	}

	#desktop .dock-item:hover .dock-icon {
		color: var(--accent-ink);
		background: var(--accent-bg);
	}

	#desktop .dock-item:hover .dock-arrow,
	.dock-item:focus-visible .dock-arrow {
		opacity: 1;
		transform: none;
		fill: var(--accent-ink);
	}

	.dock-rule {
		height: 1px;
		margin: 8px 10px;
		background: var(--hairline);
	}

	.dock-foot {
		display: none;
		padding: 6px 10px 4px;
		font-family: var(--font-mono);
		font-size: 10.5px;
		letter-spacing: 0.08em;
		color: var(--ink-3);
	}

	.dock-foot.show {
		display: block;
	}

	/* Signed out, these routes all answer with a 401 anyway. */
	.dock-private {
		display: none;
	}

	.dock-private.show {
		display: flex;
	}

	/* Already home, so the link would go nowhere. */
	.page-home .dock-home {
		display: none;
	}

	@media screen and (max-width: 560px) {
		.dock-trigger {
			top: calc(14px + env(safe-area-inset-top, 0px));
			right: 14px;
		}

		.dock {
			top: calc(68px + env(safe-area-inset-top, 0px));
			right: 14px;
			width: calc(100vw - 28px);
			max-width: 320px;
		}
	}

	@media (prefers-reduced-motion: reduce) {

		.dock.open .dock-item,
		.dock.open .dock-icon {
			animation: none;
		}
	}
</style>

<script>
	(() => {
		const trigger = document.getElementById('dock-trigger');
		const dock = document.getElementById('dock');
		const scrim = document.getElementById('dock-scrim');
		const auth = document.getElementById('dock-auth');
		const authLabel = document.getElementById('dock-auth-label');
		const authHint = document.getElementById('dock-auth-hint');
		const foot = document.getElementById('dock-foot');
		const private_ = [...dock.querySelectorAll('.dock-private')];

		let open = false;

		// auth.js declares `account` with const, so it is a lexical global and
		// never becomes a property of window. Reading window.account always
		// gave undefined, which is why the dock kept offering Login.
		const currentUser = () =>
			typeof account !== 'undefined' ? account?.username : undefined;

		const syncAccount = () => {
			const username = currentUser();
			const signedIn = Boolean(username);

			for (const item of private_) item.classList.toggle('show', signedIn);

			auth.href = signedIn ? '/account' : '/login';
			authLabel.textContent = signedIn ? 'Account' : 'Login';
			authHint.textContent = signedIn
				? 'Session and QR token'
				: 'Well hello there';

			foot.classList.toggle('show', signedIn);
			foot.textContent = signedIn ? `Signed in as ${username}` : '';

			return signedIn;
		};

		const setOpen = (next) => {
			open = next;
			trigger.classList.toggle('open', open);
			dock.classList.toggle('open', open);
			scrim.classList.toggle('open', open);
			trigger.setAttribute('aria-expanded', String(open));
			trigger.setAttribute(
				'aria-label',
				open ? 'Close shortcuts' : 'Open shortcuts'
			);

			if (open) {
				syncAccount();
				dock.querySelector('.dock-item:not([style*="display: none"])')
					?.focus({ preventScroll: true });
			}
		};

		trigger.addEventListener('click', () => setOpen(!open));
		scrim.addEventListener('click', () => setOpen(false));

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && open) {
				setOpen(false);
				trigger.focus({ preventScroll: true });
			}
		});

		document.addEventListener('click', (event) => {
			if (!open) return;
			if (
				event.target.closest('#dock') ||
				event.target.closest('#dock-trigger')
			) {
				return;
			}
			setOpen(false);
		});

		// The token check is a round trip, so the answer usually lands after
		// this runs. Re-check a few times rather than waiting for a click.
		syncAccount();

		let attempts = 0;
		const poll = setInterval(() => {
			if (syncAccount() || ++attempts > 12) clearInterval(poll);
		}, 400);
	})();
</script>