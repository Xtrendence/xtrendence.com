<section class="hero section" id="home">
    <div class="shell hero-inner">
        <div class="avatar glass reveal">
            <img
                src="https://www.xtrendence.dev/assets/img/me.jpg"
                alt="Khodadad (Adrian) Nouchin"
                draggable="false"
            />
        </div>

        <span class="status glass reveal" style="--delay: 60ms">
            <i class="dot"></i> Front-End Engineer at Artis Works
        </span>

        <h1 class="reveal" style="--delay: 120ms">
            Khodadad <span class="alias gradient-text">(Adrian)</span> Nouchin
        </h1>

        <p class="hero-role reveal" style="--delay: 180ms">
            <span>Full-stack engineer working on</span>
            <span class="rotator" id="rotator">
                <span>candlestick charts</span>
                <span>real-time market data</span>
                <span>dependency graphs</span>
                <span>open-source tools</span>
                <span>encryption and privacy</span>
