            <div class="stat" data-stat="experience">
                <b>4+</b><span>Years commercial</span>
            </div>
            <div class="stat" data-stat="repos">
                <b>44</b><span>Public repos</span>
            </div>
            <div class="stat" data-stat="stars" data-suffix="+">
